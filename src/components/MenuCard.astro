---
/**
 * One menu/combo/add-on card — matches `buildMenuCard()` /
 * `buildCombosAccordion()` / `renderAddons()` in v1's script.js exactly:
 * <article class="menu-card"><div class="menu-card-inner"><picture>...
 * Rendered at build time from menu.json (Phase 3 invisible improvement —
 * v1 built this with client JS after a fetch()).
 *
 * Phase 4 (owner-approved visible change): names/descriptions arrive already
 * cleaned by displayName()/displayDescription() in src/lib/data.ts — no emoji,
 * no "[Regular, 7 inches]" / "[Veg preparation]" catalogue markers. The real
 * buying information from those markers (size, spice level) comes back as
 * `meta`, rendered as a muted line under the title.
 */
import type { MenuImage } from '../lib/data';
import { lateNightOffCartIds } from '../lib/data';

interface Props {
  /**
   * One photo, or several. Several renders a swipeable gallery; one renders
   * the plain <picture> this card has always rendered, byte for byte.
   */
  img: MenuImage | MenuImage[];
  title: string;
  description: string;
  price: number;
  meta?: string[];
  extraClass?: string;
  /**
   * Catalogue id (see `orderCatalog` in lib/data.ts). When present the card
   * gets an Add button that puts the item in the cart; when absent the card is
   * display-only, which is what a no-JS visitor keeps either way — the button
   * is inert without JS, so the card never promises an action it cannot do.
   */
  cartId?: string;
}
const { img, title, description, price, meta = [], extraClass, cartId } = Astro.props;
const photos = Array.isArray(img) ? img : [img];
const hasGallery = photos.length > 1;
---

<article class:list={['menu-card', extraClass]}>
  <div class="menu-card-inner">
    {
      hasGallery ? (
        <div class="menu-card-gallery">
          {/*
            The swipe itself is CSS scroll-snap, so it works with no JS at all:
            a phone gets native inertia, a trackpad gets horizontal scroll.
            The script below only lights up the dots and adds desktop arrows —
            if it never runs, photo 1 still shows and the rest still scroll.
          */}
          <div
            class="menu-card-track"
            role="group"
            aria-roledescription="carousel"
            aria-label={`${title} — ${photos.length} photos`}
            tabindex="0"
          >
            {photos.map((photo, i) => (
              <picture class="menu-card-slide">
                {photo.avif && <source type="image/avif" srcset={photo.avif} />}
                <source type="image/webp" srcset={photo.webp} />
                <img
                  src={photo.webp}
                  alt={i === 0 ? title : `${title} — photo ${i + 1}`}
                  class="menu-card-img"
                  loading="lazy"
                  draggable="false"
                />
              </picture>
            ))}
          </div>
          <div class="menu-card-dots" aria-hidden="true">
            {photos.map((_, i) => (
              <span class:list={['menu-card-dot', i === 0 && 'is-active']} />
            ))}
          </div>
          <button type="button" class="menu-card-arrow prev" aria-label={`Previous photo of ${title}`} hidden>
            &#8249;
          </button>
          <button type="button" class="menu-card-arrow next" aria-label={`Next photo of ${title}`} hidden>
            &#8250;
          </button>
        </div>
      ) : (
        <picture>
          {photos[0].avif && <source type="image/avif" srcset={photos[0].avif} />}
          <source type="image/webp" srcset={photos[0].webp} />
          <img src={photos[0].webp} alt={title} class="menu-card-img" loading="lazy" />
        </picture>
      )
    }
    <div class="menu-card-body">
      <h3 class="menu-card-title">{title}</h3>
      {
        meta.length > 0 && (
          <p class="menu-card-meta" style="font-size: 0.78rem; color: var(--color-text-muted); letter-spacing: 0.04em; text-transform: uppercase; margin: -0.35rem 0 0.6rem;">
            {meta.join(' · ')}
          </p>
        )
      }
      <p style="font-size: 0.9rem; color: var(--color-text-muted); margin-bottom: 1rem;">
        {description}
      </p>
      <div class="menu-card-foot">
        {/*
          data-base-price is the normal price, kept as a number so the offer
          script (P0-B) can put it back when an offer ends without parsing
          "₹129" out of the text it just overwrote.
        */}
        <div class="menu-card-price" data-base-price={price}>₹{price}</div>
        {
          cartId && (
            <button
              type="button"
              class="add-to-cart"
              data-cart-id={cartId}
              data-cart-name={title}
              data-late-night={String(!lateNightOffCartIds.has(cartId))}
              aria-label={`Add ${title} to your order`}
            >
              Add
            </button>
          )
        }
      </div>
    </div>
  </div>
</article>

{/*
  Dots + desktop arrows. Astro hoists this once for the whole page no matter
  how many cards render it. Everything here is decoration on top of a gallery
  that already scrolls without it — see the comment on .menu-card-gallery.
*/}
<script>
  function initMenuGalleries() {
    const galleries = document.querySelectorAll<HTMLElement>('.menu-card-gallery');
    for (const gallery of galleries) {
      if (gallery.dataset.galleryReady === '1') continue;
      gallery.dataset.galleryReady = '1';

      const track = gallery.querySelector<HTMLElement>('.menu-card-track');
      const dots = Array.from(gallery.querySelectorAll<HTMLElement>('.menu-card-dot'));
      const prev = gallery.querySelector<HTMLButtonElement>('.menu-card-arrow.prev');
      const next = gallery.querySelector<HTMLButtonElement>('.menu-card-arrow.next');
      if (!track || dots.length < 2) continue;

      const index = () => Math.round(track.scrollLeft / track.clientWidth);

      const paint = () => {
        const i = Math.max(0, Math.min(dots.length - 1, index()));
        dots.forEach((dot, n) => dot.classList.toggle('is-active', n === i));
        if (prev) prev.disabled = i === 0;
        if (next) next.disabled = i === dots.length - 1;
      };

      // Painting is three class toggles, so it runs straight off the scroll
      // event — no requestAnimationFrame throttle, which does not fire at all
      // in a background tab and would leave the dots stuck on photo 1.
      track.addEventListener('scroll', paint, { passive: true });

      const go = (step: number) => {
        const i = Math.max(0, Math.min(dots.length - 1, index() + step));
        // Assigning scrollLeft animates via `scroll-behavior: smooth` in the
        // stylesheet, and still lands on the slide when animation is off
        // (reduced motion, background tab) — scrollTo({behavior}) does not.
        track.scrollLeft = i * track.clientWidth;
        // Don't wait for the scroll event to come back — the browser can
        // coalesce or delay it, and a dot that lags the photo looks broken.
        paint();
      };

      // The arrows ship hidden so a no-JS visitor never sees a dead control.
      for (const [button, step] of [
        [prev, -1],
        [next, 1],
      ] as const) {
        if (!button) continue;
        button.hidden = false;
        button.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          go(step);
        });
      }

      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          go(1);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          go(-1);
        }
      });

      paint();
    }
  }

  initMenuGalleries();
  document.addEventListener('astro:page-load', initMenuGalleries);
</script>
