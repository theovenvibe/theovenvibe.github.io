---
/**
 * Rings the kitchen when someone leaves this site for Zomato or Swiggy.
 *
 * Those orders arrive in the partner's own app, which the kitchen may not be
 * watching either — and unlike a WhatsApp order there is no message to miss,
 * just a tablet that beeps somewhere. A heads-up that a customer went that way
 * means the kitchen knows to look, and it is the only visibility we have into
 * how much traffic this site actually sends to the partners.
 *
 * Like every alert here, it fires on the CLICK: someone can still change their
 * mind in the app. The wording says "may land", never "you have an order".
 *
 * Delegated on the document and matched by hostname, so every Zomato/Swiggy
 * link is covered — the home-page buttons, the footer, `/sundargarh/`, and any
 * added later without anyone remembering to wire this up.
 */
import { site } from '../lib/data';

const partnerConfig = { workerUrl: site.backend.worker_url };
---

<script
  type="application/json"
  id="partner-alert-config"
  is:inline
  set:html={JSON.stringify(partnerConfig)}
/>

<script>
  import { makeOnce } from '../lib/notify';
  import { getDeviceId } from '../lib/device';

  const el = document.getElementById('partner-alert-config');
  const { workerUrl } = JSON.parse(el?.textContent ?? '{}') as { workerUrl?: string };

  if (workerUrl) {
    // Matched on hostname rather than on a CSS class: a link is a partner link
    // because of where it points, not because someone remembered to label it.
    const PARTNERS: { match: RegExp; name: string; tags: string }[] = [
      { match: /(^|\.)zomato\.com$/i, name: 'Zomato', tags: 'motorcycle' },
      { match: /(^|\.)swiggy\.com$/i, name: 'Swiggy', tags: 'motorcycle' },
    ];

    const once = makeOnce();

    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement | null)?.closest<HTMLAnchorElement>('a[href]');
      if (!link) return;

      let host: string;
      try {
        host = new URL(link.href, window.location.href).hostname;
      } catch {
        return;
      }

      const partner = PARTNERS.find((p) => p.match.test(host));
      if (!partner) return;
      // Same partner twice in a row is one customer, not two.
      if (!once(partner.name)) return;

      /*
       * WHERE they left from is the whole point of this alert (owner, 2026-08-20).
       *
       * "Someone left for Swiggy" on its own is just bad news. Whether they left
       * from the footer — where the link is a leak, a customer we could have
       * served walking out — or from the out-of-range block at checkout, where
       * it is the only thing we can offer someone eight kilometres away, are
       * opposite events. One is a problem to fix, the other is the system
       * working.
       */
      /*
       * WHERE they left from, and WHO they were, decide whether this is a
       * problem or the system working (owner, 2026-08-20).
       *
       * Footer: a customer we could have served, walking out.
       * Out-of-range box at checkout: the only thing we can offer somebody eight
       * kilometres away.
       *
       * The name and number ride along when checkout already has them, so the
       * owner can ring someone who was about to order and did not. Recorded as
       * well as alerted — two clicks is not evidence, a fortnight of them is.
       */
      const inFooter = Boolean(link.closest('footer'));
      const inBeyond = Boolean(link.closest('#beyondActions'));
      const nameEl = document.getElementById('nameInput') as HTMLInputElement | null;
      const phoneEl = document.getElementById('phoneInput') as HTMLInputElement | null;
      const kmEl = document.getElementById('kmInput') as HTMLInputElement | null;

      fetch(`${workerUrl}/demand-signal`, {
        method: 'POST',
        keepalive: true,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          kind: 'partner_click',
          partner: partner.name,
          source: inBeyond ? 'beyond' : inFooter ? 'footer' : 'page',
          page: window.location.pathname,
          name: nameEl?.value?.trim() || undefined,
          phone: phoneEl?.value?.trim() || undefined,
          km: kmEl?.value ? Number(kmEl.value) : undefined,
          device_id: getDeviceId(),
        }),
      }).catch(() => {
        // The customer is already on their way to another app. Nothing to do
        // and nothing to show them.
      });
    });
  }
</script>
