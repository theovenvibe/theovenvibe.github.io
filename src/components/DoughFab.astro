---
/**
 * Floating Dough balance.
 *
 * Sits above the basket FAB, and only appears once a customer actually has
 * Dough. Zero is not shown: a currency you have none of is an advertisement,
 * and the customer did not ask for one — the /dough page is where the pitch
 * lives.
 *
 * The cached value paints first so the bubble does not blink as the customer
 * browses, but it is always revalidated behind that - a balance that only
 * refreshes when the tab is closed will happily advertise money that has
 * already been spent. If the Worker is unreachable the cached number stands
 * and nothing blocks (AGENTS.md rule 5).
 */
import { site } from '../lib/data';

const enabled = Boolean(site.backend.worker_url);
---

{
  enabled && (
    <a href="/dough/" class="dough-fab" id="doughFab" hidden aria-label="Your Dough balance">
      <img src="/static/images/svg/dough.svg" alt="" width="30" height="30" />
      <span class="dough-fab-amount" id="doughFabAmount">₹0</span>
    </a>
  )
}

{
  enabled && (
    <script
      type="application/json"
      id="dough-fab-config"
      is:inline
      set:html={JSON.stringify({ workerUrl: site.backend.worker_url })}
    />
  )
}

<script>
  import { getDeviceId } from '../lib/device';
  import { fetchDough, publishDough, rememberedPhone, DOUGH_CACHE_KEY, DOUGH_EVENT } from '../lib/dough';

  const fab = document.getElementById('doughFab');
  const amountEl = document.getElementById('doughFabAmount');
  const cfgEl = document.getElementById('dough-fab-config');

  if (fab && amountEl && cfgEl) {
    const { workerUrl } = JSON.parse(cfgEl.textContent ?? '{}') as { workerUrl?: string };

    // Zero hides it. Showing a balance of nothing is an advertisement the
    // customer did not ask for, and leaving a stale number on screen after the
    // money is gone is worse than never showing one.
    const show = (balance: number) => {
      amountEl.textContent = `₹${balance}`;
      fab.hidden = balance <= 0;
    };

    const cached = sessionStorage.getItem(DOUGH_CACHE_KEY);
    if (cached) show(Number(cached) || 0);

    if (workerUrl) {
      // The number is remembered by checkout and by the "Check your Dough"
      // form, so a customer who has told us once is recognised on every page
      // afterwards. Without it this could only identify a device that had
      // allowed notifications — almost nobody — and someone with a real
      // balance saw no button and assumed their Dough had gone.
      const refresh = async () => {
        const { balance } = await fetchDough(workerUrl, getDeviceId(), rememberedPhone());
        publishDough(balance);
      };

      // Checkout knows the customer by the phone they typed, which beats a
      // device guess - so whatever it learns wins here too.
      window.addEventListener(DOUGH_EVENT, (e) => show((e as CustomEvent).detail.balance));

      void refresh();

      // Coming back to the tab is the moment a stale number is most likely:
      // the customer has just ordered, or spent it somewhere else.
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') void refresh();
      });
    }
  }
</script>
