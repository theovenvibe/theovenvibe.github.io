---
/**
 * Sticky top nav + mobile overlay — ported verbatim from v1's nav markup
 * (index.html / contact.html / faq.html / blog.html / sundargarh-770001.html
 * / blog-*.html all share this exact block). PRD §8 superseded block: v1's
 * markup, classes and copy are preserved as-is.
 *
 * v1 quirks preserved on purpose (do not "fix" — see PRD §8 pixel-parity rule):
 * - the "active" class on the Contact nav-link appears ONLY on the Contact
 *   page itself; no other page marks any nav item active (including Home).
 * - the mobile overlay has 6 links on the home page (adds "Combos & Offers"
 *   and "Sides & Add-ons") vs 4 links everywhere else.
 * - on the home page, in-page links are bare hashes (#menu); everywhere else
 *   they point back at the home route (/#menu) — same as v1's
 *   "index.html#menu" pattern, translated to the new route path.
 */
import { site } from '../lib/data';

interface Props {
  home?: boolean;
  activeContact?: boolean;
}
const { home = false, activeContact = false } = Astro.props;
const menuHref = home ? '#menu' : '/#menu';
const partyHref = home ? '#party' : '/#party';
const whyHref = home ? '#why' : '/#why';
---

<!-- STICKY NAVIGATION BAR -->
<nav class="main-navbar" role="navigation">
  <div class="nav-container">
    <div class="nav-brand">
      <a href="/" class="logo-link">
        <picture>
          <source
            type="image/avif"
            srcset="/static/images/brand_images/optimized/The_Oven_vibe_logo_128px.avif 128w,
                  /static/images/brand_images/optimized/The_Oven_vibe_logo_48px.avif   48w"
            sizes="(min-width: 900px) 48px, 48px"
          />
          <source
            type="image/webp"
            srcset="/static/images/brand_images/optimized/The_Oven_vibe_logo_128px.webp 128w,
                  /static/images/brand_images/optimized/The_Oven_vibe_logo_48px.webp   48w"
            sizes="(min-width: 900px) 48px, 48px"
          />
          <img
            src="/static/images/brand_images/optimized/The_Oven_vibe_logo_128px.webp"
            alt="The Oven Vibe logo"
            class="logo-img"
            loading="lazy"
            width="48"
            height="48"
          />
        </picture>
      </a>
      <span class="brand-text">{site.business.name}</span>
    </div>

    <ul class="nav-links" id="siteNav">
      {/*
        Flat, no dropdowns (owner, 2026-08-20). Menu used to hide Dough, Refer,
        Party Orders and the calculator behind a hover — four things a customer
        has no reason to look for under "Menu", so they were effectively
        invisible. Every destination is now one tap.

        Blog and Contact came out to make room. Both are in the footer, which is
        where people already look for them.
      */}
      <li><a href={menuHref} class="nav-link">Menu</a></li>

      {/*
        Offers sits second, right after Menu: it is where every push and ad
        lands, and a customer arriving cold should see it without hunting.
        Deliberately styled to stand out from the rest of the nav (P0-K).
      */}
      <li><a href="/offer/" class="nav-link nav-link-offer">Offers</a></li>

      <li><a href="/dough/" class="nav-link">Dough</a></li>
      <li><a href="/refer/" class="nav-link">Refer</a></li>
      <li><a href={partyHref} class="nav-link">Party Orders</a></li>
      <li><a href="/price-calculator/" class="nav-link">Price Calculator</a></li>
      <li><a href={whyHref} class="nav-link">Why Us</a></li>

      {/* The basket IS the nav's call to action, owner decision 2026-08-15.
          It replaced an "Order Now" button that pointed at a bare wa.me link:
          tapping it opened an empty WhatsApp chat with no item, no quote and no
          context, leaving the customer to type the order from memory. A button
          that promises ordering should carry the order. The badge appears only
          once something is in the basket; the icon itself always shows, so
          people learn where the basket lives before they fill it. */}
      <li>
        <a href="/checkout/" class="btn btn-primary nav-cart" aria-label="Your order">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span class="nav-cart-label">Order</span>
          <span class="nav-cart-count js-cart-count js-cart-hide-empty" hidden>0</span>
        </a>
      </li>
    </ul>

    <!-- MOBILE MENU TOGGLE -->
    <div class="mobile-menu-toggle" id="mobileMenuToggle">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
</nav>

<!-- MOBILE MENU OVERLAY -->
<div class="mobile-menu-overlay" id="mobileMenuOverlay">
  <div class="mobile-menu-header">
    <span class="brand-text">{site.business.name}</span>
    <button class="close-menu-btn" id="closeMenuBtn">&times;</button>
  </div>
  <ul class="mobile-nav-links">
    <li><a href="/" class="mobile-nav-link">Home</a></li>
    <li><a href={menuHref} class="mobile-nav-link">Menu</a></li>
    <li><a href="/offer/" class="mobile-nav-link">Offers</a></li>
    <li><a href="/dough/" class="mobile-nav-link">Dough</a></li>
    <li><a href="/refer/" class="mobile-nav-link">Refer</a></li>
    <li><a href={partyHref} class="mobile-nav-link">Party Orders</a></li>
    <li><a href="/price-calculator/" class="mobile-nav-link">Price Calculator</a></li>
    <li><a href={whyHref} class="mobile-nav-link">Why Us</a></li>
    {/* A full-screen overlay has room the navbar does not, so Blog and Contact
        stay here even though they came out of the desktop bar. */}
    <li><a href="/blog/" class="mobile-nav-link">Blog</a></li>
    <li>
      <a href="/checkout/" class="mobile-nav-link">
        Your order <span class="nav-cart-count js-cart-count js-cart-hide-empty" hidden>0</span>
      </a>
    </li>
    <li><a href="/contact/" class:list={['mobile-nav-link', { active: activeContact }]}>Contact</a></li>
  </ul>
</div>
