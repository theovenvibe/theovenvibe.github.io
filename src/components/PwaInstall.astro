---
/**
 * Registers the service worker (public/sw.js) and offers the app install —
 * never a native prompt on page load.
 *
 * Rebuilt 2026-08-28 to match PushSubscribe.astro. This used to be a card
 * fixed to the bottom of the screen, which is the exact silhouette of a cookie
 * bar; people have spent a decade training themselves to swipe past that shape
 * without reading it. Same centred dialog now, and the same outcome tracking,
 * so "how many said yes" is a number rather than a guess.
 *
 * Android Chrome fires `beforeinstallprompt`; we capture and defer it, and only
 * call `.prompt()` from an explicit tap on our own dialog (PRD §8.2's soft-ask
 * philosophy, applied to install instead of push permission).
 *
 * iOS Safari never fires that event and has no programmatic install at all
 * (PRD §4.2) — Share → Add to Home Screen is manual, so there the dialog is an
 * instruction with a single "Got it" rather than an Install button. Worth
 * knowing: Instagram's and WhatsApp's in-app browsers cannot install a PWA at
 * all, which is where a lot of this site's traffic arrives from.
 */
---

<div id="pwaInstallOverlay" class="push-ask-overlay" hidden>
  <div
    class="push-ask-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="pwaInstallTitle"
    aria-describedby="pwaInstallText"
  >
    <h2 class="push-ask-title" id="pwaInstallTitle">Keep us one tap away</h2>
    <p class="push-ask-text" id="pwaInstallText"></p>
    <div class="push-ask-actions">
      <button type="button" id="pwaInstallBtn" class="btn btn-primary push-ask-btn" hidden>
        Install app
      </button>
      <button type="button" id="pwaInstallDismiss" class="btn btn-secondary push-ask-btn">
        Not now
      </button>
    </div>
    <p class="push-ask-fine">No app store, no account. It is just our site on your home screen.</p>
  </div>
</div>

<script>
  import { anotherBannerVisible } from '../lib/soft-banner';
  import { reportAsk } from '../lib/ask-report';

  const DISMISS_KEY = 'ovenvibe.pwa_install_dismissed_at';
  const DISMISS_DAYS = 30;
  // Read from the same config the rest of the site uses. Absent means order
  // capture is off entirely, in which case there is nothing to report to.
  const workerUrl =
    (document.getElementById('push-config')?.textContent
      ? (JSON.parse(document.getElementById('push-config')!.textContent!) as { workerUrl?: string }).workerUrl
      : '') ?? '';

  function recentlyDismissed(): boolean {
    try {
      const raw = window.localStorage.getItem(DISMISS_KEY);
      if (!raw) return false;
      return (Date.now() - Number(raw)) / 86400000 < DISMISS_DAYS;
    } catch {
      return false;
    }
  }

  function isStandalone(): boolean {
    return (
      window.matchMedia?.('(display-mode: standalone)').matches ||
      // iOS Safari's own flag — not in the standard matchMedia check.
      (navigator as Navigator & { standalone?: boolean }).standalone === true
    );
  }

  if ('serviceWorker' in navigator) {
    // After load, not blocking first paint or the checkout flow.
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    });
  }

  if (!isStandalone() && !recentlyDismissed()) {
    const overlay = document.getElementById('pwaInstallOverlay') as HTMLElement;
    const text = document.getElementById('pwaInstallText') as HTMLElement;
    const installBtn = document.getElementById('pwaInstallBtn') as HTMLButtonElement;
    const dismissBtn = document.getElementById('pwaInstallDismiss') as HTMLButtonElement;

    let deferredPrompt: Event | null = null;
    let lastFocused: Element | null = null;
    let open = false;

    function remember() {
      try {
        window.localStorage.setItem(DISMISS_KEY, String(Date.now()));
      } catch {
        // Not remembering just means it may show again sooner than 30 days.
      }
    }

    function close(outcome: 'no' | 'dismissed') {
      if (!open) return;
      open = false;
      overlay.hidden = true;
      document.body.style.removeProperty('overflow');
      remember();
      reportAsk(workerUrl, 'install', outcome, 'install');
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    }

    function show(message: string, withButton: boolean) {
      // Never on top of the notification dialog: two different asks in the
      // same breath is how a site starts feeling like it wants something.
      if (open || anotherBannerVisible()) return;
      open = true;
      text.textContent = message;
      installBtn.hidden = !withButton;
      // With no Install button the dialog is pure instruction, so the only
      // action left should read as acknowledgement rather than refusal.
      dismissBtn.textContent = withButton ? 'Not now' : 'Got it';
      lastFocused = document.activeElement;
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      (withButton ? installBtn : dismissBtn).focus();
      reportAsk(workerUrl, 'install', 'shown', 'install');
    }

    dismissBtn.addEventListener('click', () => close('no'));

    // A backdrop tap and Escape both get out. A dialog you cannot escape is
    // what makes people distrust a site, and distrust reads as a no.
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close('dismissed');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) close('dismissed');
    });

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      // Not immediately: an install dialog thrown at somebody who just landed
      // is an ad. Chrome only fires this after its own engagement heuristics
      // anyway, so by here they have already used the site a little.
      show('Add The Oven Vibe to your home screen for faster ordering — no app store needed.', true);
    });

    installBtn.addEventListener('click', async () => {
      if (!deferredPrompt) return;
      installBtn.disabled = true;
      open = false;
      overlay.hidden = true;
      document.body.style.removeProperty('overflow');
      remember();
      // @ts-expect-error — BeforeInstallPromptEvent isn't in lib.dom yet.
      await deferredPrompt.prompt();
      // Chrome resolves userChoice with what they did at ITS prompt, which is
      // a different decision from tapping our button — worth keeping apart, so
      // "they wanted it but backed out" does not look like "they refused".
      let accepted = false;
      try {
        // @ts-expect-error — same missing type.
        const choice = await deferredPrompt.userChoice;
        accepted = choice?.outcome === 'accepted';
      } catch {
        // Older Chrome without userChoice; treat as unknown rather than a no.
      }
      reportAsk(workerUrl, 'install', accepted ? 'yes_granted' : 'yes_denied', 'install');
    });

    // iOS: no event to wait for, so show the manual instruction once the page
    // has settled, on Safari specifically. Deliberately narrow — a UA sniff
    // wide enough to catch Chrome/Android would show Apple's instructions to
    // people for whom they are wrong.
    const ua = navigator.userAgent;
    const isIOS = /iPhone|iPad|iPod/.test(ua);
    const isSafari = /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS/.test(ua);
    if (isIOS && isSafari) {
      show('To add us to your home screen: tap Share, then "Add to Home Screen".', false);
    }
  }
</script>
