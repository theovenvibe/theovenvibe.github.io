---
/**
 * The live quote and the two actions that send it — the end of every order
 * flow, shared by `/price-calculator/` and `/checkout/`.
 *
 * Driven by `src/lib/order-form.ts`, which owns these element IDs. Both
 * buttons are disabled until there is a real total to send: an empty basket,
 * a closed kitchen, a below-minimum order and an out-of-range address each
 * leave them inert rather than sending the kitchen something it cannot cook.
 *
 * Styles: `styles/order-form.css` (global — see OrderOptions.astro).
 */
import { LINKS } from '../lib/seo';
import { site } from '../lib/data';

interface Props {
  /** Heading above the quote. Checkout says "Your order"; the calculator "Your total". */
  heading?: string;
  /** Label on the primary button. */
  sendLabel?: string;
  /**
   * false when the button leads somewhere on this site (the calculator's
   * handoff to /checkout/). Leaving a WhatsApp link's `target="_blank"` on an
   * internal hop strands the customer in a second tab with the first one still
   * showing the old basket.
   */
  newTab?: boolean;
}

const { heading = 'Your total', sendLabel = 'Send on WhatsApp', newTab = true } = Astro.props;
---

<div class="calc-output-wrap">
  <h2 style="margin-bottom: 1rem;">{heading}</h2>
  <div id="quoteOutput" class="calc-output" aria-live="polite"></div>
  <div class="calc-actions" id="sendActions">
    <a
      id="waShareLink"
      class="btn btn-primary"
      target={newTab ? '_blank' : undefined}
      rel={newTab ? 'noopener noreferrer' : undefined}
      aria-disabled="true">{sendLabel}</a
    >
  </div>

  {/*
    The one place platform links belong (owner's call, 2026-08-18).

    Beyond the delivery radius we cannot cook for this customer at all, and the
    buttons above go inert — a dead end at the exact moment someone is ready to
    order. Zomato and Swiggy cover that distance, so here they are a service,
    not a leak: this customer was never ours to lose. That is precisely why the
    same buttons were taken off the homepage, where the customer was already
    ours (see `docs/PLATFORM_LINKS.md`).

    Hidden by default and revealed by order-form.ts only on an out-of-range
    quote. It replaces the dead pair rather than sitting beside it — two greyed
    buttons next to two live ones is a puzzle, not a choice.
  */}
  <div class="calc-actions" id="beyondActions" hidden>
    <a href={LINKS.zomato} target="_blank" rel="noopener noreferrer" class="btn btn-zomato">Order on Zomato</a>
    <a href={LINKS.swiggy} target="_blank" rel="noopener noreferrer" class="btn btn-swiggy">Order on Swiggy</a>
  </div>

  {/*
    Ask where they live, instead of watching them leave.

    Shown with the partner buttons above, and only then. A long ride costs the
    kitchen a rider for 45 minutes at dinner time, so the question of whether to
    deliver 4-8 km is worth answering with a list of real areas rather than a
    guess. This is how that list gets made.
  */}
  <div class="area-ask" id="areaAsk" hidden>
    <p class="area-ask-title">We don't deliver that far yet</p>
    <p class="area-ask-body">
      Tell us your area and we'll message you the day we start. It costs you nothing and it
      genuinely decides where we go next.
    </p>
    <form class="area-ask-form" id="areaAskForm">
      <label class="sr-only" for="areaAskInput">Your area</label>
      <input
        id="areaAskInput"
        name="area"
        type="text"
        maxlength="60"
        placeholder="Which area do you live in?"
        required
      />
      <button type="submit" class="btn btn-primary" id="areaAskBtn">Tell us</button>
    </form>
    <p class="area-ask-result" id="areaAskResult" role="status" hidden></p>
  </div>
</div>

<script define:vars={{ workerUrl: site.backend.worker_url ?? '' }}>
  /**
   * "Where do you live?" — asked once, at the only moment it is not nosy: right
   * after being told we do not deliver that far.
   *
   * This is the number that decides whether a 4-8 km band is worth opening. Two
   * partner clicks were not evidence; a fortnight of named areas is.
   */
  const deviceId = (() => {
    try {
      const k = 'ovenvibe.device_id.v1';
      let v = localStorage.getItem(k);
      if (!v) { v = crypto.randomUUID(); localStorage.setItem(k, v); }
      return v;
    } catch { return ''; }
  })();

  const form = document.getElementById('areaAskForm');
  const input = document.getElementById('areaAskInput');
  const btn = document.getElementById('areaAskBtn');
  const out = document.getElementById('areaAskResult');

  if (form && input && btn && out && workerUrl) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const area = input.value.trim();
      if (!area) return;
      btn.disabled = true;
      btn.textContent = 'Sending…';
      const nameEl = document.getElementById('custName');
      const phoneEl = document.getElementById('custPhone');
      const kmEl = document.getElementById('kmInput');
      try {
        const res = await fetch(`${workerUrl}/demand-signal`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            kind: 'area_request',
            source: 'beyond',
            page: window.location.pathname,
            area,
            name: nameEl?.value?.trim() || undefined,
            phone: phoneEl?.value?.trim() || undefined,
            km: kmEl?.value ? Number(kmEl.value) : undefined,
            device_id: deviceId,
          }),
        });
        if (!res.ok) throw new Error('failed');
        out.hidden = false;
        out.classList.remove('is-bad');
        out.textContent = `Thank you — ${area} is on our list. We'll message you the day we reach you.`;
        form.hidden = true;
      } catch {
        out.hidden = false;
        out.classList.add('is-bad');
        out.textContent = 'That did not send. Check your connection and try once more.';
        btn.disabled = false;
        btn.textContent = 'Tell us';
      }
    });
  }
</script>
