---
/**
 * The #menu section's contents on the home page: Combos & Offers accordion
 * first, then one accordion per category — the exact order and structure
 * `script.js` built client-side after `fetch('menu.json')`. Now build-time
 * from src/lib/data.ts (Phase 3 invisible improvement — no more empty
 * section popping in after load).
 */
import AccordionItem from './AccordionItem.astro';
import MenuCard from './MenuCard.astro';
import {
  menu,
  categories,
  availableCombos,
  imageFor,
  displayName,
  displayMeta,
  displayDescription,
} from '../lib/data';

const codeToName = new Map<string, string>();
for (const item of menu.Menu_Items) {
  codeToName.set(item.product_code, displayName(item.display_name || item.item_name));
}

function comboDescription(combo: (typeof availableCombos)[number]): string {
  if (combo.description) {
    const text = displayDescription(combo);
    return text.toLowerCase().includes('includes') ? text : `Includes: ${text}`;
  }
  const readable = combo.items_included.map((code) => codeToName.get(code) ?? code).join(', ');
  return `Includes: ${readable}`;
}
---

{
  availableCombos.length > 0 && (
    <AccordionItem title="Combos & Offers" subtitle={`${availableCombos.length} ${availableCombos.length === 1 ? 'offer' : 'offers'}`} id="sec-combos">
      <div class="menu-items combo-list">
        {availableCombos.map((c) => (
          <MenuCard
            img={imageFor(c)}
            title={displayName(c.combo_name)}
            meta={displayMeta(c.combo_name)}
            description={comboDescription(c)}
            price={c.combo_price}
          />
        ))}
      </div>
    </AccordionItem>
  )
}

{
  categories.map(({ name, items }) => (
    <AccordionItem title={name} subtitle={`${items.length} ${items.length === 1 ? 'item' : 'items'}`}>
      <div class="category-group">
        <div class="menu-items">
          {items.map((item) => (
            <MenuCard
              img={imageFor(item)}
              title={displayName(item.display_name || item.item_name)}
              meta={displayMeta(item.display_name || item.item_name)}
              description={displayDescription(item)}
              price={item.price}
            />
          ))}
        </div>
      </div>
    </AccordionItem>
  ))
}
