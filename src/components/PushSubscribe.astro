---
/**
 * The push soft-ask (PRD §8.2 — read that section before touching this file,
 * the sequencing is the entire point of it).
 *
 * Rebuilt 2026-08-28. It used to be a small card fixed to the bottom of the
 * screen, and in production it won 2 subscriptions — both of them the owner's
 * own test devices. Two things were wrong, and only fixing both helps:
 *
 *   POSITION. A bottom-fixed strip is the exact shape of a cookie bar, and
 *   people have spent a decade training themselves to swipe past that shape
 *   without reading it. They were not saying no; they never saw it.
 *
 *   TIMING. It only appeared when somebody came BACK to the tab after tapping
 *   "Send order on WhatsApp". Almost nobody switches back. The trigger barely
 *   ever fired, so a better-looking card in the same slot would still have
 *   been shown to nobody.
 *
 * So: a centred dialog, and three moments instead of one, each with a pitch
 * that answers a question that person is already asking —
 *
 *   order   back from WhatsApp, on /checkout/ — "did the kitchen see it?"
 *   dough   on /dough/, once a balance is on screen — "when does mine land?"
 *   offers  on /, once the offer strip is in view  — "tell me about new deals"
 *
 * `/offer/` is deliberately NOT a trigger: it had zero visits in the traffic
 * we have. The deal-hunting happens in the offers strip on the home page.
 *
 * Still never a native prompt on load. `Notification.requestPermission()` is
 * reached from exactly one place — the "Yes" handler in lib/push.ts — so a
 * "Not now" can never burn the browser's one-shot permission.
 */
import { site } from '../lib/data';

const enabled = Boolean(site.push.vapid_public_key) && Boolean(site.backend.worker_url);
---

{
  enabled && (
    <div id="pushAskOverlay" class="push-ask-overlay" hidden>
      {/*
        A real dialog: labelled, focus-trapped by the browser's own inert
        handling of ::backdrop-less overlays is NOT free, so the script below
        moves focus in and restores it on close. role="dialog" + aria-modal
        is what tells a screen reader the rest of the page is inert.
      */}
      <div
        class="push-ask-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="pushAskTitle"
        aria-describedby="pushAskText"
      >
        <h2 class="push-ask-title" id="pushAskTitle">Want a heads-up?</h2>
        <p class="push-ask-text" id="pushAskText">
          Want our flash deals and new-item alerts on this device?
        </p>
        <div class="push-ask-actions">
          <button type="button" id="pushAskYes" class="btn btn-primary push-ask-btn">
            Yes, notify me
          </button>
          {/*
            Same size and weight as Yes on purpose. A greyed-out ghost button
            next to a big coloured one is a fake choice, and a fake choice is
            what makes a site feel like it is trying something on you.
          */}
          <button type="button" id="pushAskNo" class="btn btn-secondary push-ask-btn">
            Not now
          </button>
        </div>
        <p class="push-ask-fine" id="pushAskFine">One notification. No spam, ever.</p>
      </div>
    </div>
    <script
      type="application/json"
      id="push-config"
      is:inline
      set:html={JSON.stringify({ vapidPublicKey: site.push.vapid_public_key, workerUrl: site.backend.worker_url })}
    />
  )
}

<script>
  import { consumeOrderJustSent } from '../lib/push-signal';
  import { askAndSubscribe, iosNotInstalled, pushSupported } from '../lib/push';
  import { DOUGH_PHONE_KEY } from '../lib/dough';
  import { reportAsk } from '../lib/ask-report';
  import { hideOtherBanners } from '../lib/soft-banner';

  const overlayEl = document.getElementById('pushAskOverlay');
  if (overlayEl) {
    const overlay: HTMLElement = overlayEl;
    const configEl = document.getElementById('push-config');
    const { vapidPublicKey, workerUrl } = JSON.parse(configEl?.textContent ?? '{}') as {
      vapidPublicKey: string;
      workerUrl: string;
    };

    // ONE key for all three triggers. Per-trigger keys would let somebody be
    // asked on the home page, then again on /dough/, then again at checkout —
    // three asks in one evening, which is how a soft-ask becomes a nuisance.
    const DISMISS_KEY = 'ovenvibe.push_ask_dismissed_at';
    const DISMISS_DAYS = 30;
    // Proof they are a customer, used to keep the home-page ask off cold
    // traffic (see shouldAskOnHome below). `ov_phone` is written by checkout
    // and by the "Check your Dough" form; `ovenvibe.customer.v1` is the
    // saved delivery details. Both are real keys read out of the code, not
    // guessed — a wrong key here fails silently and the home ask would
    // simply never fire.
    const WARM_KEYS = [DOUGH_PHONE_KEY, 'ovenvibe.customer.v1'];

    type Trigger = 'order' | 'dough' | 'offers';

    const PITCH: Record<Trigger, { title: string; text: string; yes: string }> = {
      order: {
        title: 'Know when we start cooking',
        text: 'We will send one notification the moment the kitchen accepts your order.',
        yes: 'Yes, tell me',
      },
      dough: {
        title: 'Know when your Dough lands',
        text: 'We will tell you when Dough is added to your number, and before it expires.',
        yes: 'Yes, tell me',
      },
      offers: {
        title: 'Know when a new deal drops',
        text: 'We will send a notification when a new offer goes live. Only when there is one.',
        yes: 'Yes, notify me',
      },
    };

    let shown = false;
    let lastFocused: Element | null = null;

    function recentlyDismissed(): boolean {
      try {
        const raw = window.localStorage.getItem(DISMISS_KEY);
        if (!raw) return false;
        return (Date.now() - Number(raw)) / 86400000 < DISMISS_DAYS;
      } catch {
        return false;
      }
    }

    function recordDismissal() {
      try {
        window.localStorage.setItem(DISMISS_KEY, String(Date.now()));
      } catch {
        // Not remembering just means we might ask again sooner than 30 days.
      }
    }

    /** Both dialogs report through one helper, so the two cannot drift apart. */
    function report(outcome: 'shown' | 'yes_granted' | 'yes_denied' | 'no' | 'dismissed', trigger: Trigger | null) {
      reportAsk(workerUrl, 'push', outcome, trigger);
    }

    function close(outcome: 'no' | 'dismissed', trigger: Trigger) {
      overlay.hidden = true;
      document.body.style.removeProperty('overflow');
      report(outcome, trigger);
      // A backdrop tap or Escape is "not now", not a refusal — but it still
      // sets the 30-day key, because showing the same dialog again on the
      // next page view is exactly the behaviour people hate.
      recordDismissal();
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    }

    function open(trigger: Trigger) {
      if (shown || recentlyDismissed()) return;
      shown = true;

      const pitch = PITCH[trigger];
      const titleEl = document.getElementById('pushAskTitle');
      const textEl = document.getElementById('pushAskText');
      const yesEl = document.getElementById('pushAskYes');
      if (titleEl) titleEl.textContent = pitch.title;
      if (textEl) textEl.textContent = pitch.text;
      if (yesEl) yesEl.textContent = pitch.yes;

      lastFocused = document.activeElement;
      // The install banner and this dialog must never be up together: two
      // different asks in the same breath is how a site starts feeling like
      // it wants something from you. The dialog wins, because a notification
      // permission is one-shot and permanent while an install prompt can be
      // offered again any time.
      hideOtherBanners();
      overlay.hidden = false;
      // The page behind must not scroll under a modal — on a phone that
      // reads as the dialog being stuck to a moving background.
      document.body.style.overflow = 'hidden';
      (yesEl as HTMLElement | null)?.focus();
      report('shown', trigger);

      // Escape and a backdrop tap both close it. A modal you cannot get out
      // of is what makes people distrust a site — and distrust is a no.
      overlay.addEventListener(
        'click',
        (e) => {
          if (e.target === overlay) close('dismissed', trigger);
        },
        { once: false },
      );
      document.addEventListener('keydown', function onKey(e) {
        if (e.key !== 'Escape' || overlay.hidden) return;
        document.removeEventListener('keydown', onKey);
        close('dismissed', trigger);
      });

      document.getElementById('pushAskNo')?.addEventListener(
        'click',
        () => {
          // No requestPermission on this path — the native prompt is
          // untouched, so this person can be asked again after 30 days.
          close('no', trigger);
        },
        { once: true },
      );

      document.getElementById('pushAskYes')?.addEventListener(
        'click',
        async () => {
          recordDismissal();
          overlay.hidden = true;
          document.body.style.removeProperty('overflow');
          const result = await askAndSubscribe(vapidPublicKey, workerUrl);
          // 'failed' is a network or service-worker problem, not a decision —
          // recording it as a denial would make the pitch look worse than it is.
          report(result === 'granted' ? 'yes_granted' : result === 'denied' ? 'yes_denied' : 'shown', trigger);
          if (lastFocused instanceof HTMLElement) lastFocused.focus();
        },
        { once: true },
      );
    }

    /**
     * Home page only: has this person ever been a customer?
     *
     * A permission refused is refused for the whole origin, permanently. An
     * Instagram visitor who has never tasted the food is both the likeliest
     * to say no and the least valuable yes — spending the one shot on them
     * is the worst trade available. /checkout/ and /dough/ need no such gate:
     * being there already means they are a customer.
     */
    function shouldAskOnHome(): boolean {
      try {
        return WARM_KEYS.some((k) => window.localStorage.getItem(k));
      } catch {
        return false;
      }
    }

    /** Fire `cb` the first time `el` is at least half on screen. */
    function onceInView(el: Element, cb: () => void) {
      if (!('IntersectionObserver' in window)) return;
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            io.disconnect();
            cb();
          }
        },
        { threshold: 0.5 },
      );
      io.observe(el);
    }

    // A person on iOS who has not installed cannot receive push at all
    // (Apple's rule), and `denied` means the browser will never ask again —
    // in both cases the dialog would be a pure annoyance.
    if (pushSupported() && !iosNotInstalled() && Notification.permission === 'default' && !recentlyDismissed()) {
      const path = location.pathname;

      // 1. Back from WhatsApp. Kept from the original: /checkout/ is 38% of
      //    page views, so this moment does have an audience — it was the
      //    bottom-of-screen position losing it, not the timing.
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState !== 'visible') return;
        if (!consumeOrderJustSent()) return;
        open('order');
      });

      // 2. Dough, once the balance is actually on screen — after they have
      //    seen what they came for, never instead of it.
      if (path.startsWith('/dough')) {
        const balance = document.getElementById('doughBalance');
        if (balance) onceInView(balance, () => open('dough'));
      }

      // 3. Home, once the offers strip is in view, and only for somebody we
      //    already know.
      if ((path === '/' || path === '') && shouldAskOnHome()) {
        const combos = document.getElementById('sec-combos');
        if (combos) onceInView(combos, () => open('offers'));
      }
    }
  }
</script>
