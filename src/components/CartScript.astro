---
/**
 * Wires the cart on every page: the Add buttons on menu cards, and the floating
 * basket's visibility and count.
 *
 * Rendered from `Layout.astro` so any page that grows a menu card later gets
 * this for free. The script is a module (Vite-bundled) because it imports
 * `lib/cart.ts`; `public/scripts/site.js` cannot, being a plain file served
 * as-is.
 */
import CartFab from './CartFab.astro';
import '../styles/cart.css';
import { lateNightWindow, site } from '../lib/data';

interface Props {
  /** Off on /checkout/ — a button that goes where you already are is clutter. */
  showFab?: boolean;
}
const { showFab = true } = Astro.props;
---

{/*
  The late-night window reaches the client on a data attribute, never through
  an import. `lib/data.ts` reads menu.json with readFileSync at build time, so
  importing it from a client <script> bundles readFileSync into the browser,
  where it throws — which killed the whole module and with it the add-to-cart
  handler, on every page (owner-reported at 3am, 2026-08-17).
*/}
<span
  id="lateNightWindow"
  hidden
  data-from={lateNightWindow.from}
  data-to={lateNightWindow.to}
  data-worker={site.backend.worker_url}
  data-vapid={site.push.vapid_public_key}
  data-whatsapp={site.business.whatsapp}
></span>
{showFab && <CartFab />}

<script>
  import { addItem, cartCount, onCartChange } from '../lib/cart';
  import { getDeviceId } from '../lib/device';
  import { askAndSubscribe, iosNotInstalled, pushPermission } from '../lib/push';

  /**
   * The boiling stations shut after closing, so pasta and maggi are not cooked
   * during the late-night window. The price calculator and checkout both knew
   * that; these Add buttons did not, so a customer could fill a basket at 1am
   * with no hint anything was wrong and only discover it at checkout
   * (owner-reported, 2026-08-17).
   *
   * Adding is still allowed rather than blocked: checkout supports pre-ordering
   * for after the kitchen reopens, and a customer awake at 1am who wants pasta
   * tomorrow should not be turned away. What was missing was honesty, not a
   * lock — so the card says so, and the button says "Pre-order".
   */
  // Inlined rather than imported from lib/pricing: this file must not pull in
  // anything that reaches lib/data, and a minutes comparison is four lines.
  function inLateNightWindow(): boolean {
    const el = document.getElementById('lateNightWindow');
    const from = el?.dataset.from;
    const to = el?.dataset.to;
    if (!from || !to) return false;
    const mins = (s: string) => Number(s.slice(0, 2)) * 60 + Number(s.slice(3, 5));
    const now = new Date();
    const t = now.getHours() * 60 + now.getMinutes();
    const f = mins(from);
    const u = mins(to);
    // The window wraps past midnight (23:30 → 02:00).
    return f <= u ? t >= f && t <= u : t >= f || t <= u;
  }

  /**
   * What the Worker last said is off the menu, keyed on bare product code.
   * Empty until the first fetch answers, and empty again on any failure — an
   * unreachable Worker must never take an item off the menu.
   */
  let soldOut: Record<string, { back_at: string | null }> = {};

  /**
   * Offer prices, keyed the same way (P0-B). Empty means "everything at its
   * normal price", which is what any failure has to land on — an unreachable
   * Worker must never invent a discount, and must never hide one it cannot
   * confirm by leaving a stale one on screen either.
   */
  let offers: Record<string, { price: number; label: string | null; ends_at: string | null }> = {};

  /**
   * Whether the kitchen is taking orders right now (P0-H).
   *
   * Defaults to open and stays open on any failure. Closed does NOT mean
   * blocked: every item stays orderable as a pre-order, which is the owner's
   * whole point — a closure should collect demand, not lose it.
   */
  let store: { open: boolean; reason: string | null; message: string | null; until: string | null } = {
    open: true, reason: null, message: null, until: null,
  };

  const CLOSE_REASONS: Record<string, string> = {
    out_of_stock: 'we have run out of a few things',
    kitchen_full: 'the kitchen is at capacity',
    staff: 'we are short-staffed',
    lpg: 'our gas ran out',
    festival: 'we are closed for a festival',
    travel: 'we are away',
    temporary: 'we are closed for a bit',
    other: 'we are closed for a bit',
  };

  /**
   * Both rules that can change an Add button live here, in one pass.
   *
   * They used to be two functions that each wrote `textContent`, which was fine
   * only because each ran once and sold-out ran last. Now that both re-run on a
   * timer, whichever fired most recently would win — so an item put back on the
   * menu could stay reading "Sold out", or a sold-out item could quietly become
   * "Add" again at the top of the minute. One painter, one order of precedence.
   *
   * Sold out beats pre-order: an item the kitchen has run out of cannot be
   * ordered for later either.
   */
  function paintButtons() {
    const late = inLateNightWindow();
    for (const btn of Array.from(document.querySelectorAll<HTMLElement>('.add-to-cart'))) {
      // The label Astro rendered, captured before anything overwrites it — this
      // is what "back on the menu" has to restore to.
      if (btn.dataset.baseLabel === undefined) btn.dataset.baseLabel = btn.textContent ?? 'Add';

      // Cart ids are "item-<code>" / "combo-<code>" / "addon-<code>"; the
      // Worker keys on the bare product code.
      const code = (btn.dataset.cartId ?? '').replace(/^(item|combo|addon)-/, '');
      const off = Object.prototype.hasOwnProperty.call(soldOut, code);
      const served = btn.dataset.lateNight !== 'false';
      // Closed kitchen: everything becomes a pre-order, not just the items the
      // boiling stations cannot make. Sold out still wins over both.
      const preorder = !off && ((late && !served) || !store.open);

      btn.classList.toggle('is-late-night-off', preorder);
      btn.toggleAttribute('disabled', off);
      if (off) {
        btn.textContent = 'Sold out';
        btn.setAttribute('aria-label', `${btn.dataset.cartName ?? 'This item'} is sold out`);
      } else if (preorder) {
        btn.textContent = 'Pre-order';
        btn.setAttribute(
          'aria-label',
          `Pre-order ${btn.dataset.cartName ?? 'this item'} — not cooked at this hour`,
        );
      } else {
        btn.textContent = btn.dataset.baseLabel;
        btn.removeAttribute('aria-label');
      }

      const card = btn.closest('.menu-card');
      if (!card) continue;
      card.classList.toggle('is-sold-out', off);
      card.classList.toggle('is-late-night-off', preorder);

      let soldNote = card.querySelector<HTMLElement>('.sold-out-note');
      if (off && !soldNote) {
        soldNote = document.createElement('p');
        soldNote.className = 'sold-out-note';
        card.querySelector('.menu-card-foot')?.before(soldNote);
      } else if (!off && soldNote) {
        soldNote.remove();
        soldNote = null;
      }
      if (soldNote) {
        // Rewritten every pass, not just on creation: a "back at 7pm" the owner
        // changes to 8pm has to reach a page that is already open.
        const backAt = soldOut[code]?.back_at;
        soldNote.textContent = backAt ? `Sold out — ${formatBackAt(backAt)}.` : 'Sold out for now.';
      }

      paintNotifyButton(card, code, off, btn.dataset.cartName ?? 'this item');

      let lateNote = card.querySelector<HTMLElement>('.late-night-note');
      if (preorder && !lateNote) {
        lateNote = document.createElement('p');
        lateNote.className = 'late-night-note';
        card.querySelector('.menu-card-foot')?.before(lateNote);
      } else if (!preorder && lateNote) {
        lateNote.remove();
        lateNote = null;
      }
      if (lateNote) {
        // Two different reasons to pre-order, and saying the wrong one is worse
        // than saying nothing: "not cooked at this hour" is nonsense at 2pm on a
        // day the kitchen is shut for a festival.
        lateNote.textContent = !store.open
          ? 'Kitchen is closed — pre-order it for when we reopen.'
          : 'Not cooked at this hour — pre-order it for later.';
      }

      paintPrice(card, code);
    }
  }

  /* -------------------------------------------------------------------------
   * The kitchen-closed banner (P0-H)
   *
   * Says three things, in this order: we are closed, why, and when we are back.
   * Then it offers the one thing a customer who came here to order can still
   * do — pre-order — and, if they would rather wait, a soft-ask to be told the
   * moment we reopen.
   *
   * That soft-ask is deliberate. Somebody who arrived wanting food and found a
   * closed kitchen is the highest-intent visitor the site ever gets, and this
   * is the least annoying possible moment to ask for a notification
   * permission (owner's standing instruction, 2026-08-17).
   * ---------------------------------------------------------------------- */
  function paintClosedBanner() {
    let banner = document.getElementById('kitchenClosedBanner');

    if (store.open) {
      banner?.remove();
      return;
    }
    if (!banner) {
      banner = document.createElement('div');
      banner.id = 'kitchenClosedBanner';
      banner.className = 'kitchen-closed';
      banner.setAttribute('role', 'status');
      document.querySelector('main')?.prepend(banner);
    }

    const why = store.reason ? CLOSE_REASONS[store.reason] ?? 'we are closed for a bit' : 'we are closed for a bit';
    const back = store.until ? ` We are back ${formatBackAt(store.until).replace(/^back /, '')}.` : '';
    // The owner types this in a hurry and rarely ends it with a full stop, which
    // ran their sentence straight into ours.
    const note = store.message ? ` ${store.message.replace(/[.!?]?$/, '.')}` : '';

    banner.innerHTML =
      '<p class="kitchen-closed-title">The kitchen is closed right now</p>' +
      `<p class="kitchen-closed-body">Sorry — ${why}.${back}${note} ` +
      'You can still pre-order: build your basket as normal and we will cook it as soon as we are back.</p>';

    // Only worth offering where it can actually be granted.
    const state = pushPermission();
    if (state === 'default' && !iosNotInstalled()) {
      const ask = document.createElement('button');
      ask.type = 'button';
      ask.className = 'kitchen-closed-ask';
      ask.textContent = 'Tell me when we are open';
      ask.addEventListener('click', async () => {
        const el = document.getElementById('lateNightWindow');
        const vapid = el?.dataset.vapid ?? '';
        const worker = el?.dataset.worker ?? '';
        if (!vapid) return;
        ask.disabled = true;
        ask.textContent = 'One moment…';
        const result = await askAndSubscribe(vapid, worker);
        ask.textContent = result === 'granted' ? "We'll let you know" : 'Tell me when we are open';
        ask.disabled = result === 'granted';
      });
      banner.appendChild(ask);
    }
  }

  /* -------------------------------------------------------------------------
   * "Tell me when it's back" (P0-J)
   *
   * A customer found every pizza sold out on 2026-08-17 and the site offered
   * them nothing but a dead end. The demand walked.
   *
   * It is also the best moment on the whole site to win a push permission:
   * somebody who wants THIS pizza tonight is far likelier to allow
   * notifications than a visitor asked cold. Which is why the ask is soft —
   * a button in the page first, the native dialog only after they tap it. A
   * native prompt fired on load gets blocked, and a block is permanent for the
   * whole origin, with no way back from our side.
   *
   * If they refuse, or already have, the button becomes a WhatsApp link with
   * the message pre-written — one they send us. That direction matters: an
   * unsolicited outbound message can get the business account reported, while
   * an inbound one opens a window where replying is expected and free
   * (owner's rule, 2026-08-17).
   * ---------------------------------------------------------------------- */
  function paintNotifyButton(card: Element, code: string, off: boolean, name: string) {
    const foot = card.querySelector('.menu-card-foot');
    let btn = card.querySelector<HTMLButtonElement>('.notify-back');

    if (!off) {
      btn?.remove();
      return;
    }
    if (!foot || btn) return;

    btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'notify-back';
    btn.dataset.code = code;
    btn.dataset.name = name;
    btn.textContent = alreadyWaiting(code) ? "We'll tell you" : "Tell me when it's back";
    btn.disabled = alreadyWaiting(code);
    foot.after(btn);
  }

  /**
   * Remembered locally so a reload does not offer to sign someone up twice.
   * The Worker de-duplicates too — this is about what the button says, not
   * about data integrity.
   */
  const WAITING_KEY = 'ovenvibe.waiting.v1';

  function waitingSet(): string[] {
    try {
      return JSON.parse(window.localStorage.getItem(WAITING_KEY) ?? '[]') as string[];
    } catch {
      return [];
    }
  }
  const alreadyWaiting = (code: string) => waitingSet().includes(code);
  function rememberWaiting(code: string) {
    try {
      const all = waitingSet();
      if (!all.includes(code)) window.localStorage.setItem(WAITING_KEY, JSON.stringify([...all, code]));
    } catch {
      // Only affects the button's wording on the next visit.
    }
  }

  /** Tell the Worker. Fire-and-forget, like every other call this site makes. */
  function joinWaitlist(code: string) {
    const el = document.getElementById('lateNightWindow');
    const worker = el?.dataset.worker;
    if (!worker) return;
    fetch(`${worker}/waitlist`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ device_id: getDeviceId(), product_code: code }),
    }).catch(() => {
      // Silent. The customer has been told we will let them know; a failed
      // POST is not something they can act on.
    });
  }

  /** The fallback: a message the CUSTOMER sends us, never one we send them. */
  function whatsappFallback(name: string): string | null {
    const number = document.getElementById('lateNightWindow')?.dataset.whatsapp;
    if (!number) return null;
    const text = `Hi! Please tell me when ${name} is back in stock.`;
    return `https://wa.me/${number}?text=${encodeURIComponent(text)}`;
  }

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('.notify-back');
    if (!btn || btn.disabled) return;
    const code = btn.dataset.code ?? '';
    const name = btn.dataset.name ?? 'this item';
    const el = document.getElementById('lateNightWindow');
    const worker = el?.dataset.worker ?? '';
    const vapid = el?.dataset.vapid ?? '';

    // No permission possible on this device or in this browser: go straight to
    // the message they send us, rather than a prompt that cannot appear.
    const state = pushPermission();
    if (state === 'unsupported' || state === 'denied' || iosNotInstalled() || !vapid) {
      const href = whatsappFallback(name);
      if (href) window.open(href, '_blank', 'noopener');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'One moment…';
    const result = await askAndSubscribe(vapid, worker);
    if (result === 'granted') {
      joinWaitlist(code);
      rememberWaiting(code);
      btn.textContent = "We'll tell you";
      return;
    }

    // They said no to the browser, or it failed. Offer the other route rather
    // than leaving a dead button.
    const href = whatsappFallback(name);
    btn.disabled = false;
    btn.textContent = href ? 'Ask us on WhatsApp' : "Tell me when it's back";
    if (href && result === 'denied') window.open(href, '_blank', 'noopener');
  });

  /**
   * The price on one card: the offer price if there is one, otherwise the price
   * Astro rendered.
   *
   * The old price stays visible, struck through. Replacing ₹129 with ₹99
   * outright would leave a customer with no way to see that ₹99 is the point —
   * and the Worker already refuses to store an offer that is not lower, so the
   * strike-through can never be a lie about the direction.
   */
  function paintPrice(card: Element, code: string) {
    const priceEl = card.querySelector<HTMLElement>('.menu-card-price');
    if (!priceEl) return;
    const base = Number(priceEl.dataset.basePrice);
    if (!Number.isFinite(base)) return;

    const offer = offers[code];
    if (!offer) {
      priceEl.textContent = `₹${base}`;
      priceEl.removeAttribute('aria-label');
      return;
    }

    // Rebuilt rather than patched: the offer price and the label can both
    // change under an open page, and three elements to keep in step is three
    // chances to leave one showing last hour's number.
    priceEl.textContent = '';
    const was = document.createElement('span');
    was.className = 'price-was';
    was.textContent = `₹${base}`;
    const now = document.createElement('span');
    now.className = 'price-now';
    now.textContent = `₹${offer.price}`;
    priceEl.append(was, now);
    if (offer.label) {
      const label = document.createElement('span');
      label.className = 'price-label';
      label.textContent = offer.label;
      priceEl.appendChild(label);
    }
    priceEl.setAttribute('aria-label', `₹${offer.price}, down from ₹${base}`);
  }

  /* -------------------------------------------------------------------------
   * Sold out right now (P0-A).
   *
   * The menu is baked into these pages at build time, so the kitchen running
   * out of something used to mean a commit and a rebuild. The Worker keeps a
   * small list of what is off; this reads it and marks those cards.
   *
   * Fails open, always: any error, any unreachable Worker, and every item
   * stays orderable (AGENTS.md rule 5 — never block a customer from ordering).
   * The owner confirms every order by hand, so an over-sold item is a phone
   * call; a site that refuses orders because a fetch failed is lost money.
   * ---------------------------------------------------------------------- */
  function formatBackAt(iso: string): string {
    // 12-hour with am/pm, in IST, to match how the rest of the site writes
    // times ("11:30pm", never "23:30").
    const d = new Date(iso);
    const parts = new Intl.DateTimeFormat('en-IN', {
      hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Kolkata',
    }).formatToParts(d);
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
    const time = `${get('hour')}${get('minute') !== '00' ? ':' + get('minute') : ''}${get('dayPeriod').toLowerCase().replace(/\s/g, '')}`;
    const istToday = new Date(Date.now() + 5.5 * 3600000).toISOString().slice(0, 10);
    const istThen = new Date(d.getTime() + 5.5 * 3600000).toISOString().slice(0, 10);
    if (istThen === istToday) return `back at ${time}`;
    const day = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' }).format(d);
    return `back ${day}, ${time}`;
  }

  /**
   * Ask the Worker what is off, then repaint.
   *
   * This ran exactly once, at page load. A customer who opened the menu before
   * the kitchen ran out of pizza saw it in stock for as long as that tab stayed
   * open, and could order it (owner-reported, 2026-08-17). Sold-out is a live
   * fact about the kitchen right now, so the page has to keep asking.
   */
  function refreshAvailability() {
    const worker = document.getElementById('lateNightWindow')?.dataset.worker;
    if (!worker) return;
    fetch(`${worker}/availability`)
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (!d || !d.ok || !d.sold_out) return;
        soldOut = d.sold_out;
        // Older Workers answered without this field. Treating "absent" as "no
        // offers" keeps a stale deployment showing honest normal prices rather
        // than crashing the painter and freezing the sold-out list with it.
        offers = d.offers ?? {};
        // An older Worker has no `store` key; absent means open, which is the
        // safe direction and what the site did before this existed.
        store = d.store ?? { open: true, reason: null, message: null, until: null };
        paintButtons();
        paintClosedBanner();
      })
      .catch(() => {
        // Silence is correct here: everything stays as it is, which means
        // available. AGENTS.md rule 5 — never block a customer from ordering.
      });
  }

  paintButtons();
  refreshAvailability();

  // The late-night window opens at 23:30 while someone is already on the page,
  // and the kitchen runs out of things mid-evening. Both need re-checking
  // rather than trusting whatever was true at page load. The Worker caches
  // /availability for 20s, so a minute here costs it very little.
  window.setInterval(() => {
    paintButtons();
    refreshAvailability();
  }, 60000);

  // A phone that has been in a pocket runs no timers. Someone coming back to
  // the tab is exactly the person about to tap Add, so check on the way in
  // rather than leaving them up to a minute of stale menu.
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') {
      paintButtons();
      refreshAvailability();
    }
  });
  // Same reasoning for the back button, which restores a frozen page from
  // bfcache with none of its timers having fired.
  window.addEventListener('pageshow', (e) => {
    if ((e as PageTransitionEvent).persisted) {
      paintButtons();
      refreshAvailability();
    }
  });

  // Every place that shows a basket count opts in with these classes, so the
  // nav badge and the floating button can never disagree about what is in the
  // basket — and a third one added later needs no change here.
  const counts = Array.from(document.querySelectorAll<HTMLElement>('.js-cart-count'));
  const hideWhenEmpty = Array.from(document.querySelectorAll<HTMLElement>('.js-cart-hide-empty'));

  function paintCount(n: number) {
    for (const el of counts) el.textContent = String(n);
    // An empty basket shows nothing rather than a "0" the customer has to
    // interpret. The nav's cart icon is exempt: it stays put so people learn
    // where the basket lives before they have put anything in it.
    for (const el of hideWhenEmpty) el.hidden = n === 0;
  }

  paintCount(cartCount());
  onCartChange((cart) => paintCount(cartCount(cart)));

  // Delegated, so cards inside a collapsed accordion (or added later) work
  // without re-binding.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('.add-to-cart');
    if (!btn) return;
    const id = btn.dataset.cartId;
    if (!id) return;

    addItem(id, 1);

    // Say so on the button. Without this the only feedback is a badge in the
    // far corner, which is easy to miss — and a customer who thinks the tap
    // missed taps again and orders two.
    const preorder = btn.classList.contains('is-late-night-off');
    btn.classList.add('is-added');
    btn.textContent = preorder ? 'Added for later' : 'Added';
    window.setTimeout(() => {
      btn.classList.remove('is-added');
      // Repaint rather than restoring the label captured at click time: the
      // item may have sold out in between, and putting "Add" back would invite
      // a second tap on something the kitchen no longer has.
      paintButtons();
    }, preorder ? 2000 : 1200);
  });
</script>
