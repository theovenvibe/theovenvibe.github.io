---
/**
 * Wires the cart on every page: the Add buttons on menu cards, and the floating
 * basket's visibility and count.
 *
 * Rendered from `Layout.astro` so any page that grows a menu card later gets
 * this for free. The script is a module (Vite-bundled) because it imports
 * `lib/cart.ts`; `public/scripts/site.js` cannot, being a plain file served
 * as-is.
 */
import CartFab from './CartFab.astro';
import '../styles/cart.css';
import { lateNightWindow, site } from '../lib/data';

interface Props {
  /** Off on /checkout/ — a button that goes where you already are is clutter. */
  showFab?: boolean;
}
const { showFab = true } = Astro.props;
---

{/*
  The late-night window reaches the client on a data attribute, never through
  an import. `lib/data.ts` reads menu.json with readFileSync at build time, so
  importing it from a client <script> bundles readFileSync into the browser,
  where it throws — which killed the whole module and with it the add-to-cart
  handler, on every page (owner-reported at 3am, 2026-08-17).
*/}
<span
  id="lateNightWindow"
  hidden
  data-from={lateNightWindow.from}
  data-to={lateNightWindow.to}
  data-worker={site.backend.worker_url}
></span>
{showFab && <CartFab />}

<script>
  import { addItem, cartCount, onCartChange } from '../lib/cart';

  /**
   * The boiling stations shut after closing, so pasta and maggi are not cooked
   * during the late-night window. The price calculator and checkout both knew
   * that; these Add buttons did not, so a customer could fill a basket at 1am
   * with no hint anything was wrong and only discover it at checkout
   * (owner-reported, 2026-08-17).
   *
   * Adding is still allowed rather than blocked: checkout supports pre-ordering
   * for after the kitchen reopens, and a customer awake at 1am who wants pasta
   * tomorrow should not be turned away. What was missing was honesty, not a
   * lock — so the card says so, and the button says "Pre-order".
   */
  // Inlined rather than imported from lib/pricing: this file must not pull in
  // anything that reaches lib/data, and a minutes comparison is four lines.
  function inLateNightWindow(): boolean {
    const el = document.getElementById('lateNightWindow');
    const from = el?.dataset.from;
    const to = el?.dataset.to;
    if (!from || !to) return false;
    const mins = (s: string) => Number(s.slice(0, 2)) * 60 + Number(s.slice(3, 5));
    const now = new Date();
    const t = now.getHours() * 60 + now.getMinutes();
    const f = mins(from);
    const u = mins(to);
    // The window wraps past midnight (23:30 → 02:00).
    return f <= u ? t >= f && t <= u : t >= f || t <= u;
  }

  function markLateNightItems() {
    const late = inLateNightWindow();
    for (const btn of Array.from(document.querySelectorAll<HTMLElement>('.add-to-cart'))) {
      const served = btn.dataset.lateNight !== 'false';
      const off = late && !served;
      btn.classList.toggle('is-late-night-off', off);
      if (off) {
        btn.textContent = 'Pre-order';
        btn.setAttribute(
          'aria-label',
          `Pre-order ${btn.dataset.cartName ?? 'this item'} — not cooked at this hour`,
        );
      }
      const card = btn.closest('.menu-card');
      if (!card) continue;
      card.classList.toggle('is-late-night-off', off);
      let note = card.querySelector<HTMLElement>('.late-night-note');
      if (off && !note) {
        note = document.createElement('p');
        note.className = 'late-night-note';
        note.textContent = 'Not cooked at this hour — pre-order it for later.';
        card.querySelector('.menu-card-foot')?.before(note);
      } else if (!off && note) {
        note.remove();
      }
    }
  }

  markLateNightItems();
  // The window opens at 23:30 while someone is already on the page, so re-check
  // rather than trusting whatever was true at page load.
  window.setInterval(markLateNightItems, 60000);

  /* -------------------------------------------------------------------------
   * Sold out right now (P0-A).
   *
   * The menu is baked into these pages at build time, so the kitchen running
   * out of something used to mean a commit and a rebuild. The Worker keeps a
   * small list of what is off; this reads it and marks those cards.
   *
   * Fails open, always: any error, any unreachable Worker, and every item
   * stays orderable (AGENTS.md rule 5 — never block a customer from ordering).
   * The owner confirms every order by hand, so an over-sold item is a phone
   * call; a site that refuses orders because a fetch failed is lost money.
   * ---------------------------------------------------------------------- */
  function formatBackAt(iso: string): string {
    // 12-hour with am/pm, in IST, to match how the rest of the site writes
    // times ("11:30pm", never "23:30").
    const d = new Date(iso);
    const parts = new Intl.DateTimeFormat('en-IN', {
      hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Kolkata',
    }).formatToParts(d);
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
    const time = `${get('hour')}${get('minute') !== '00' ? ':' + get('minute') : ''}${get('dayPeriod').toLowerCase().replace(/\s/g, '')}`;
    const istToday = new Date(Date.now() + 5.5 * 3600000).toISOString().slice(0, 10);
    const istThen = new Date(d.getTime() + 5.5 * 3600000).toISOString().slice(0, 10);
    if (istThen === istToday) return `back at ${time}`;
    const day = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' }).format(d);
    return `back ${day}, ${time}`;
  }

  function applySoldOut(soldOut: Record<string, { back_at: string | null }>) {
    for (const btn of Array.from(document.querySelectorAll<HTMLElement>('.add-to-cart'))) {
      // Cart ids are "item-<code>" / "combo-<code>" / "addon-<code>"; the
      // Worker keys on the bare product code.
      const code = (btn.dataset.cartId ?? '').replace(/^(item|combo|addon)-/, '');
      const off = Object.prototype.hasOwnProperty.call(soldOut, code);
      const card = btn.closest('.menu-card');
      if (!card) continue;

      card.classList.toggle('is-sold-out', off);
      btn.toggleAttribute('disabled', off);
      if (off) {
        btn.textContent = 'Sold out';
        btn.setAttribute('aria-label', `${btn.dataset.cartName ?? 'This item'} is sold out`);
      }

      let note = card.querySelector<HTMLElement>('.sold-out-note');
      if (off && !note) {
        note = document.createElement('p');
        note.className = 'sold-out-note';
        const backAt = soldOut[code]?.back_at;
        note.textContent = backAt ? `Sold out — ${formatBackAt(backAt)}.` : 'Sold out for now.';
        card.querySelector('.menu-card-foot')?.before(note);
      } else if (!off && note) {
        note.remove();
      }
    }
  }

  (function loadAvailability() {
    const worker = document.getElementById('lateNightWindow')?.dataset.worker;
    if (!worker) return;
    fetch(`${worker}/availability`)
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => { if (d && d.ok && d.sold_out) applySoldOut(d.sold_out); })
      .catch(() => {
        // Silence is correct here: everything stays available.
      });
  })();

  // Every place that shows a basket count opts in with these classes, so the
  // nav badge and the floating button can never disagree about what is in the
  // basket — and a third one added later needs no change here.
  const counts = Array.from(document.querySelectorAll<HTMLElement>('.js-cart-count'));
  const hideWhenEmpty = Array.from(document.querySelectorAll<HTMLElement>('.js-cart-hide-empty'));

  function paintCount(n: number) {
    for (const el of counts) el.textContent = String(n);
    // An empty basket shows nothing rather than a "0" the customer has to
    // interpret. The nav's cart icon is exempt: it stays put so people learn
    // where the basket lives before they have put anything in it.
    for (const el of hideWhenEmpty) el.hidden = n === 0;
  }

  paintCount(cartCount());
  onCartChange((cart) => paintCount(cartCount(cart)));

  // Delegated, so cards inside a collapsed accordion (or added later) work
  // without re-binding.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('.add-to-cart');
    if (!btn) return;
    const id = btn.dataset.cartId;
    if (!id) return;

    addItem(id, 1);

    // Say so on the button. Without this the only feedback is a badge in the
    // far corner, which is easy to miss — and a customer who thinks the tap
    // missed taps again and orders two.
    const label = btn.textContent;
    const preorder = btn.classList.contains('is-late-night-off');
    btn.classList.add('is-added');
    btn.textContent = preorder ? 'Added for later' : 'Added';
    window.setTimeout(() => {
      btn.classList.remove('is-added');
      btn.textContent = label;
    }, preorder ? 2000 : 1200);
  });
</script>
