---
/**
 * /claim/ — where an Instagram comment turns into ₹40 of Dough.
 *
 * Reached only from an auto-DM (docs/campaign/PRD.md in the backend repo).
 * Someone commented on a post, followed the account, got a link, and tapped it
 * on a phone, probably at night, probably impatient. By the time they arrive
 * they have already done everything we asked, so this page has exactly one job:
 * **do not lose them.** Three fields, one tick, one button.
 *
 * Nothing here decides anything. The Worker owns eligibility, the amount, the
 * window and the daily fuse — this is a public URL that will be forwarded
 * around Sundargarh, and anything the page could assert would eventually be
 * asserted by somebody with the console open.
 *
 * It wears the same clothes as the rest of the site — hero-mini, floating
 * shapes, the gradient display type — because the first version did not, and
 * a page that looks like it belongs to somebody else is a bad place to ask for
 * a phone number. The headline is rewritten by the script for each state, so a
 * closed campaign never sits under a hero promising ₹40.
 *
 * `noindex`, like /offer/: a campaign landing page has no business in search
 * results, where it would be found months after the campaign closed.
 */
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/data';
const workerUrl = site.backend.worker_url ?? '';
const vapidPublicKey = site.push.vapid_public_key ?? '';
const localities = site.delivery.localities ?? [];

const title = 'Claim your Dough | The Oven Vibe';
const description = 'Claim the Dough from our Instagram post and spend it on your first order.';
---

{/* Every floating button is off. This page has one job and one button; a
    WhatsApp bubble sitting on top of "Claim my ₹40", and a Dough pill landing
    on the form that is offering Dough, are both competing with it. */}
<Layout
  title={title}
  description={description}
  noindex={true}
  showCartFab={false}
  showWaFab={false}
  showDoughFab={false}
>
  <main class="main">
    <section class="hero hero-mini">
      <div class="hero-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
      </div>
      <div class="hero-container">
        <div class="hero-content" style="text-align: center; margin: 0 auto;">
          {/* Channel-neutral on purpose. This page is reached from Instagram
              AND from the QR sticker on the pizza box (campaign BOX100), and
              telling a Zomato customer holding a pizza box that they came from
              Instagram is the sort of small wrongness that makes an offer feel
              like a scam. The campaign code in the link is what records where
              they actually came from. */}
          <div class="hero-badge" id="claimBadge">
            <span class="pulse-dot"></span>
            A gift from The Oven Vibe
          </div>
          {/* Three spans, rewritten per state by the script. Written here with
              the open-campaign words so the page reads correctly for the split
              second before the Worker answers. */}
          <h1 class="hero-display" style="font-size: clamp(2.4rem, 9vw, 4rem)">
            <span class="animate-on-scroll" id="claimH1">CLAIM</span>
            {/* `line-3` as well as `text-gradient`: the gradient rule is written
                  as `.line-3.text-gradient` and needs BOTH classes, so the
                  three inner pages that use `text-gradient` alone silently
                  render flat. The amount is the thing to emphasise here, so it
                  gets the real one. */}
            <span class="line-3 text-gradient animate-on-scroll delay-100" id="claimH2">₹40</span>
            <span class="animate-on-scroll delay-200" id="claimH3">DOUGH.</span>
          </h1>
          <p class="hero-text animate-on-scroll delay-300" id="claimIntro">
            Yours to spend on your first order with us.
          </p>
        </div>
      </div>
    </section>

    <div class="section" style="padding-top: 0">
      <div class="claim-wrap">

        {/* One of these is visible at a time. Everything starts hidden and the
            script decides, because until GET /campaign answers we do not know
            whether this campaign is real, open, or worth anything — and
            guessing would mean showing "₹40" to somebody we then refuse. */}

        <div id="claimLoading" class="claim-card claim-card--quiet">
          <p>Checking your offer…</p>
        </div>

        <div id="claimClosed" class="claim-card" hidden>
          <p id="claimClosedNote">
            You have just missed this one — but the kitchen is still on, and every
            order earns you 5% back in Dough.
          </p>
          <a class="btn btn-primary claim-submit" href="/menu/">See the menu</a>
        </div>

        <div id="claimForm" class="claim-card claim-card--form" hidden>
          <form class="claim-form" id="claimFormEl" novalidate>
            <label class="claim-label" for="claimName">Your name</label>
            <input
              class="claim-input"
              id="claimName"
              name="name"
              type="text"
              autocomplete="name"
              maxlength="60"
              placeholder="What should we call you?"
              required
            />

            <label class="claim-label" for="claimPhone">Mobile number</label>
            <input
              class="claim-input"
              id="claimPhone"
              name="phone"
              type="tel"
              inputmode="numeric"
              autocomplete="tel"
              maxlength="15"
              placeholder="10-digit mobile number"
              required
            />
            {/* The second sentence exists because the first one did not close
                the loop: the owner pointed out that a customer can read "your
                Dough lives on this number", order from a different number, and
                quietly lose the Rs 100 they were just given. Nothing in the
                code can fix that -- the balance really is keyed to the phone
                number -- so the page has to say it plainly, before they type. */}
            <p class="claim-hint">
              Your Dough lives on this number — it is how we know it is yours when you order.
              <strong>Use this same number when you order, or the ₹100 will not come off your bill.</strong>
            </p>

            <label class="claim-label" for="claimArea">Your area <span class="claim-optional">(optional)</span></label>
            {/* A list rather than free text: it keeps the delivery data usable,
                and it is faster to tap than to type on a phone. Free text is
                still allowed, because somebody will live somewhere we have not
                listed and must not be stuck. */}
            <input
              class="claim-input"
              id="claimArea"
              name="area"
              type="text"
              list="claimAreaList"
              maxlength="60"
              placeholder="Where in Sundargarh?"
            />
            <datalist id="claimAreaList">
              {localities.map((l: string) => <option value={l}></option>)}
            </datalist>

            {/* Explicit, and unticked. This list gets messaged later; a
                permission we inferred from somebody filling in a form is not a
                permission. */}
            <label class="claim-consent">
              <input type="checkbox" id="claimConsent" />
              <span>
                Send me offers and order updates on WhatsApp. We will not spam you, and
                you can tell us to stop any time.
              </span>
            </label>

            <button class="btn btn-primary claim-submit" type="submit" id="claimSubmit">
              Claim my ₹<span class="claim-amount-inline">40</span>
            </button>
            <p class="claim-error" id="claimError" role="alert" hidden></p>
          </form>
        </div>

        <div id="claimDone" class="claim-card" hidden>
          <p class="claim-sub" id="claimDoneExpiry"></p>
          <p class="claim-done-note">
            It comes off your bill automatically when you order — nothing to type,
            no code to remember. You can spend up to 10% of an order in Dough.
          </p>

          {/* The one moment worth asking for a notification. They have just been
              given ₹40 for free, on their phone, on our site — goodwill will not
              be higher than this again. And the ask is in THEIR interest: "don't
              let your money vanish", not "let us market to you".

              Hidden until the script decides. It stays hidden where push is
              unsupported, on an uninstalled iPhone, or where permission was
              already answered — a button that quietly does nothing is worse
              than no button. */}
          <div class="claim-remind" id="claimRemind" hidden>
            <p class="claim-remind-q" id="claimRemindQ">Want a reminder before it expires?</p>
            {/* Deliberately NOT btn-primary. "Order now" below is the one red
                button on this screen; two identical primaries stacked made it
                impossible to tell which was the real action. */}
            <div class="claim-remind-actions">
              <button type="button" class="btn btn-secondary" id="claimRemindYes">Yes, remind me</button>
              <button type="button" class="claim-remind-no" id="claimRemindNo">No thanks</button>
            </div>
            <p class="claim-remind-done" id="claimRemindDone" hidden>
              Done — we will nudge you before it goes.
            </p>
          </div>

          <a class="btn btn-primary claim-submit" href="/menu/">Order now</a>
        </div>

        {/* Refusal is not a dead end. Somebody who is already a customer is
            standing here with their phone out, and their balance is the most
            useful thing we can put in front of them. */}
        <div id="claimKnown" class="claim-card" hidden>
          <p class="claim-sub" id="claimKnownBalance"></p>
          <a class="btn btn-primary claim-submit" href="/menu/">Order now</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script
  type="application/json"
  id="claim-config"
  is:inline
  set:html={JSON.stringify({ workerUrl, vapidPublicKey })}
/>

{/* A bundled module, not `is:inline`, so it can import lib/push and reuse the
    ONE subscribe implementation. Two copies would drift, and the copy that
    drifts is the one that silently stops registering subscribers - a failure
    nobody notices, because the symptom is an absence. Config arrives through
    the JSON element above, the same way /checkout/ does it. */}
<script>
  import { askAndSubscribe, iosNotInstalled, pushSupported } from '../lib/push';

  (() => {
    const cfgEl = document.getElementById('claim-config');
    const { workerUrl, vapidPublicKey } = JSON.parse(cfgEl?.textContent ?? '{}') as {
      workerUrl: string;
      vapidPublicKey: string;
    };
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    /** Same lookup, typed for the elements we read a value out of. */
    const inp = (id: string) => document.getElementById(id) as HTMLInputElement;
    /**
     * The hero headline belongs to the state, not to the page.
     *
     * The first version had one fixed headline and swapped only the card
     * underneath, which meant a closed campaign sat under three-inch letters
     * promising ₹40. Each state now owns its three display words, so the top of
     * the screen and the bottom can never disagree.
     */
    const HEADLINES: Record<string, [string, string, string, string]> = {
      claimLoading: ['CHECKING', 'YOUR', 'OFFER.', 'One moment.'],
      claimForm: ['CLAIM', '₹40', 'DOUGH.', 'Yours to spend on your first order with us.'],
      claimClosed: ['THIS', 'OFFER', 'HAS ENDED.', 'The kitchen is still on, though.'],
      claimDone: ['₹40', 'IS', 'YOURS.', 'It is on your number now.'],
      claimKnown: ["YOU'RE", 'ALREADY', 'WITH US.', 'This one is for new customers.'],
    };

    const show = (id: string) => {
      for (const p of ['claimLoading', 'claimClosed', 'claimForm', 'claimDone', 'claimKnown']) {
        $(p).hidden = p !== id;
      }
      const h = HEADLINES[id];
      if (h) {
        // The amount is substituted rather than hardcoded: a future campaign
        // worth ₹60 must not be announced as ₹40 by a headline nobody updated.
        $('claimH1').textContent = h[0].replace('₹40', '₹' + amount);
        $('claimH2').textContent = h[1].replace('₹40', '₹' + amount);
        $('claimH3').textContent = h[2];
        $('claimIntro').textContent = h[3];
      }
      $('claimBadge').hidden = id === 'claimClosed';
    };
    const code = new URLSearchParams(location.search).get('c') || '';
    if (!workerUrl || !code) { show('claimClosed'); return; }

    let amount = 40;
    const rupees = (n: number) => '₹' + Number(n || 0);
    // "6 October" — a date somebody reads, not an ISO string.
    const asDate = (iso: string) => {
      if (!iso) return '';
      const d = new Date(iso);
      return isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long' });
    };

    // Ask first, show second. Until this answers we do not know the amount or
    // whether the campaign is open, and promising "₹40" to somebody the Worker
    // then refuses is the one thing this page must never do.
    fetch(workerUrl + '/campaign?c=' + encodeURIComponent(code))
      .then((r) => r.json())
      .then((d: any) => {
        if (!d || !d.ok || !d.open) {
          show('claimClosed');
          return;
        }
        amount = d.amount;
        for (const el of document.querySelectorAll('.claim-amount-inline')) el.textContent = String(amount);
        show('claimForm');
      })
      .catch((err) => {
        // Log it. A bare `.catch(() => show('claimClosed'))` here once swallowed
        // a real ReferenceError - the redesign removed two elements the handler
        // still wrote to - and presented a LIVE campaign as finished. Anyone
        // debugging that from the outside sees a closed offer and no reason.
        console.error('claim: could not read the campaign', err);
        show('claimClosed');
      });

    const form = $('claimFormEl');
    const err = $('claimError');
    const btn = $('claimSubmit') as HTMLButtonElement;

    const fail = (msg: string) => {
      err.textContent = msg;
      err.hidden = false;
      btn.disabled = false;
      btn.textContent = 'Try again';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;

      const name = inp('claimName').value.trim();
      const phone = inp('claimPhone').value.trim();
      const digits = phone.replace(/\D/g, '').slice(-10);

      // Checked here as a courtesy, not as a control - the Worker checks all of
      // it again and does not trust any of this.
      if (!name) return fail('Please tell us your name.');
      if (!/^[6-9]\d{9}$/.test(digits)) return fail('That does not look like a 10-digit mobile number.');
      if (!inp('claimConsent').checked) return fail('Please tick the box so we know we may message you.');

      btn.disabled = true;
      btn.textContent = 'Claiming…';

      let d: any;
      try {
        const res = await fetch(workerUrl + '/campaign/claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            campaign: code,
            name,
            phone: digits,
            area: inp('claimArea').value.trim() || null,
            consent: true,
          }),
        });
        d = await res.json();
      } catch {
        // A claim lost to a dropped connection is a person who did everything
        // we asked and got nothing, so say so plainly rather than silently
        // failing. Their claim is not consumed - they can simply try again.
        return fail('We could not reach the kitchen. Check your connection and try again.');
      }

      if (d && d.ok) {
        try { localStorage.setItem('ov_phone', digits); } catch {}
        $('claimDoneExpiry').textContent = d.expires_at
          ? 'Spend it before ' + asDate(d.expires_at) + '.'
          : 'It is on your number now.';
        offerReminder();
        show('claimDone');
        return;
      }

      const r = d && d.refusal;
      if (r === 'already_claimed' || r === 'existing_customer') {
        show('claimKnown');
        $('claimIntro').textContent =
          r === 'already_claimed'
            ? 'This number has already claimed.'
            : 'This one is for new customers.';
        $('claimKnownBalance').textContent = d.balance
          ? 'You have ' + rupees(d.balance) + ' Dough waiting' +
            (d.expires_at ? ', expiring ' + asDate(d.expires_at) + '.' : '.')
          : 'Order today and you start earning 5% back straight away.';
        return;
      }
      if (r === 'campaign_closed' || r === 'unknown_campaign') return show('claimClosed');
      if (r === 'daily_limit') {
        return fail('We have had a rush on this offer today. Please try again tomorrow — it will still be here.');
      }
      if (r === 'bad_phone') return fail('That does not look like a 10-digit mobile number.');
      if (r === 'bad_name') return fail('Please tell us your name.');
      if (r === 'no_consent') return fail('Please tick the box so we know we may message you.');
      fail('Something went wrong at our end. Please try again in a moment.');
    });

    /**
     * Offer the expiry reminder — but only where saying yes can actually work.
     *
     * Never calls Notification.requestPermission() on its own. A native prompt
     * fired without being asked for is refused far more often, and a refusal
     * is PERMANENT for the whole origin: one careless prompt here and this
     * customer can never be sent a push again, from any page. So the card is
     * the ask, and the native prompt only follows an explicit yes.
     */
    function offerReminder() {
      if (!vapidPublicKey || !workerUrl) return;
      if (!pushSupported() || iosNotInstalled()) return;
      // 'granted' means they already subscribed somewhere; 'denied' means the
      // browser will never ask again. Both make this card a lie.
      if (Notification.permission !== 'default') return;
      $('claimRemind').hidden = false;
    }

    $('claimRemindNo')?.addEventListener('click', () => {
      // No requestPermission call on this path, so the native prompt is
      // untouched and they can still be asked another day.
      $('claimRemind').hidden = true;
    });

    $('claimRemindYes')?.addEventListener('click', async () => {
      const yes = $('claimRemindYes') as HTMLButtonElement;
      yes.disabled = true;
      yes.textContent = 'Just a moment…';
      const result = await askAndSubscribe(vapidPublicKey, workerUrl);
      $('claimRemindQ')?.remove();
      ($('claimRemind').querySelector('.claim-remind-actions') as HTMLElement).hidden = true;
      const done = $('claimRemindDone');
      // Told plainly either way. They did something and deserve to know
      // whether it worked - and if it did not, the Dough is still theirs.
      done.textContent =
        result === 'granted'
          ? 'Done — we will nudge you before it goes.'
          : 'No reminder then — your ₹' + String(amount) + ' is still yours either way.';
      done.hidden = false;
    });
  })();
</script>
