---
// /price-calculator/ — spec: "Delivery pricing, FAQ and price calculator".
// Serves two audiences with one interface: a customer working out their own
// total, and the owner quoting a price on WhatsApp while on the phone.
//
// Data contract: every price and every delivery rule comes from menu.json /
// site.config.json (via src/lib/data.ts) and is inlined into the page at
// build time — no fetch, no framework. The arithmetic itself lives in
// src/lib/pricing.ts (computeQuote), shared so this page and the FAQ can
// never compute two different answers to the same question.
//
// The form's behaviour — slot handling, availability, the rain/prepaid
// interplay, the quote text, the WhatsApp hand-off and the ntfy alert — lives
// in src/lib/order-form.ts, and its markup in components/OrderOptions.astro +
// OrderQuote.astro, because /checkout/ asks the customer exactly the same
// questions. This page supplies only its basket: the whole menu, one stepper
// per line.
//
// Progressive enhancement: the slab/rules table just below the hero is
// server-rendered and always visible, so a no-JS visitor still learns every
// price. The interactive calculator needs JavaScript for live totals and
// the copy-quote button; a <noscript> notice says so plainly.
import Layout from '../layouts/Layout.astro';
import {
  site,
  orderCatalogGroups,
  quietHoursTimeRange,
  lateNightTimeRange,
  lateNightDeliveryBands,
  maxDeliveryKm,
} from '../lib/data';
import { breadcrumbJsonLd } from '../lib/seo';
import OrderOptions from '../components/OrderOptions.astro';
import OrderQuote from '../components/OrderQuote.astro';
import '../styles/order-form.css';

const d = site.delivery;

const title = 'Delivery Price Calculator — The Oven Vibe';
const description = `Pick your items, distance and time and see your exact ${site.business.name} delivery total instantly — itemised, with the rule behind every line.`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

// The orderable catalogue (what is on the menu, and what of it survives the
// late-night window) lives in src/lib/data.ts, shared with /checkout/ and the
// add-to-cart buttons — three copies of "is this cooked at 1am" is exactly the
// drift this repo keeps designing out.
const itemGroups = orderCatalogGroups;

const calcConfig = {
  delivery: d,
  whatsapp: site.business.whatsapp,
  businessName: site.business.name,
  hours: site.business.hours,
  workerUrl: site.backend.worker_url,
};
---

<Layout
  title={title}
  description={description}
  ogTitle="Delivery Price Calculator — The Oven Vibe"
  showWaFab={false}
  jsonLd={[breadcrumbJsonLd([{ name: 'Price Calculator', path: '/price-calculator/' }])]}
>
  <main class="main">
    <!-- HERO -->
    <section class="hero hero-mini">
      <div class="hero-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
      </div>
      <div class="hero-container">
        <div class="hero-content">
          <h1 class="hero-display" style="font-size: clamp(2rem, 5vw, 4rem)">
            <span class="animate-on-scroll">PRICE</span>
            <span class="text-gradient animate-on-scroll delay-100">CALCULATOR.</span>
          </h1>
          <p class="hero-text animate-on-scroll delay-200">
            Pick your items, tell us how far and when — see your exact total before you call.
          </p>
        </div>
      </div>
    </section>

    <!-- ALWAYS-VISIBLE RULES TABLE (no-JS friendly) -->
    <div class="section" style="padding-top: 0">
      <div class="container" style="max-width: 900px">
        <h2 style="margin-bottom: 1rem;">How delivery pricing works</h2>
        <div style="overflow-x: auto; margin-bottom: 1.5rem;">
          <table class="calc-rules-table">
            <thead>
              <tr>
                <th scope="col">Distance</th>
                <th scope="col">Delivery charge</th>
                <th scope="col">Afternoon rate</th>
                <th scope="col">Minimum order</th>
                <th scope="col">Afternoon minimum</th>
                <th scope="col">Free above</th>
              </tr>
            </thead>
            <tbody>
              {
                d.slabs.map((slab) => (
                  <tr>
                    <th scope="row">{slab.label}</th>
                    <td>₹{slab.charge}</td>
                    <td>
                      {slab.label === d.quiet_hours.applies_to_slab
                        ? `₹${d.quiet_hours.charge}`
                        : '—'}
                    </td>
                    <td>₹{slab.min_order}</td>
                    <td>₹{slab.min_order_quiet}</td>
                    <td>₹{slab.free_above}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <ul class="calc-rules-list">
          <li>
            Afternoon rate: {quietHoursTimeRange}, {d.quiet_hours.days} — ₹{d.quiet_hours.charge} delivery
            for {d.quiet_hours.applies_to_slab}, minimum order ₹{d.slabs[0].min_order_quiet}. {d.quiet_hours.note}
          </li>
          <li>
            The <strong>Free above</strong> column applies during normal hours only — free
            delivery does not apply in the late-night window.
          </li>
          <li>
            Late night ({lateNightTimeRange}) costs more, and the two charges are explained in
            plain words just below this list.
          </li>
          {d.rain.active && <li>Rain surcharge active right now: +₹{d.rain.surcharge}. {d.rain.note}</li>}
          <li>
            Pickup instead of delivery: no delivery charge at all, and you still earn Dough on
            what you spend.
          </li>
          <li>
            Dough comes off items at their normal price — anything already on offer, and drinks,
            are not included. One discount at a time. You still earn Dough on the whole order.
          </li>
          <li>
            Ordering for later? If it rains when we ride out, ₹{d.rain.surcharge} is added on
            delivery — unless you pay online now, which locks your price.
          </li>
          <li>{d.beyond_note}</li>
        </ul>

        {/* Late night, explained.
            A customer asked the owner on 21 August why his bill had two
            delivery charges on it. He was reading "Delivery" and "Late-night
            delivery" as being charged twice for the same thing. The bill now
            shows one delivery number, and this block says what each of the
            two remaining charges actually pays for — because a charge people
            understand is one they accept, and everybody wants to order late. */}
        <div class="latenight-why">
          <h3>Ordering late? Here's what the extra charges are for</h3>
          <p class="latenight-why__intro">
            We close at {site.business.hours.close === '23:30' ? '11:30 PM' : site.business.hours.close}.
            An order after that means opening the kitchen again, and that costs us real money —
            so it costs you a bit more. There are only two extra charges, and this is what each
            one pays for.
          </p>

          <div class="latenight-why__item">
            <p class="latenight-why__head">
              <span>Kitchen reopen</span>
              <strong>₹{d.late_night.kitchen_charge}</strong>
            </p>
            <p class="latenight-why__note">
              On every late order — <strong>including one you collect yourself</strong>.
              The oven has to be heated back up from cold, which takes time and electricity,
              and someone who has already finished their shift has to come back and cook it.
            </p>
          </div>

          <div class="latenight-why__item">
            <p class="latenight-why__head">
              <span>The ride</span>
              <strong>
                {lateNightDeliveryBands.map((b, i) => (
                  <>{i > 0 && ' / '}₹{b.amount} <small>({b.label})</small></>
                ))}
              </strong>
            </p>
            <p class="latenight-why__note">
              Only if we deliver. This is the normal distance charge with the late-night part
              already added in, so you see one number instead of two. Riding out at that hour
              costs us more.{' '}
              <strong>Collect it yourself and you don't pay this at all.</strong>
            </p>
            <p class="latenight-why__note">
              Free delivery on bigger orders does not apply after closing — the ride costs more
              at that hour, not less, which is also why the window has its own ₹{d.late_night.min_order}{' '}
              minimum.
            </p>
          </div>

          <p class="latenight-why__foot">
            Minimum order ₹{d.late_night.min_order}, paid online in advance — we need to know the
            order is real before we light the oven. If it rains when we ride out,{' '}
            ₹{d.rain.surcharge} is added on delivery. {d.late_night.menu_note}
          </p>
        </div>
      </div>
    </div>

    <!-- INTERACTIVE CALCULATOR -->
    <div class="section" style="background-color: white; padding-top: 0">
      <div class="container" style="max-width: 900px">
        <noscript>
          <p class="calc-note calc-note--warn">
            Turn on JavaScript to calculate your exact total live — the table above has every price
            and rule, and you're welcome to call {site.business.phone_display} to confirm a total by hand.
          </p>
        </noscript>

        <h2 style="margin-bottom: 0.5rem;">Build your order</h2>
        <p class="lead" style="margin-bottom: 1rem;">
          Tap + to add items. Your total updates as you go.
        </p>
        {/* Filled by the client script from the chosen date/time: the kitchen
            is shut outside its hours, and only part of the menu is cooked in
            the late-night window. Both states grey out what cannot be made. */}
        <p id="availabilityNote" class="calc-availability" hidden></p>

        <form id="calcForm" class="calc-form">
          <!-- ITEMS -->
          <div class="calc-items">
            {
              itemGroups.map((group) => (
                <fieldset class="calc-group">
                  <legend>{group.name}</legend>
                  {group.rows.map((row) => (
                    <div class="item-row" data-id={row.id} data-name={row.name} data-price={row.price} data-late-night={String(row.lateNight)}>
                      <div class="item-row-info">
                        <span class="item-row-name">{row.name}</span>
                        <span class="item-row-price">₹{row.price}</span>
                      </div>
                      <div class="stepper" role="group" aria-label={`Quantity for ${row.name}`}>
                        <button
                          type="button"
                          class="qty-minus"
                          aria-label={`Decrease quantity of ${row.name}`}
                          disabled
                        >
                          −
                        </button>
                        <span class="qty-value" aria-hidden="true">
                          0
                        </span>
                        <button type="button" class="qty-plus" aria-label={`Increase quantity of ${row.name}`}>
                          +
                        </button>
                      </div>
                    </div>
                  ))}
                </fieldset>
              ))
            }
          </div>

          <OrderOptions />
        </form>

        <OrderQuote sendLabel="Continue to checkout →" newTab={false} />
      </div>
    </div>
  </main>
</Layout>

<script type="application/json" id="calc-config" is:inline set:html={JSON.stringify(calcConfig)} />

<script>
  import { initOrderForm, type BasketRow, type OrderFormConfig } from '../lib/order-form';
  import { getCart, setItemQty } from '../lib/cart';

  const configEl = document.getElementById('calc-config');
  const CFG: OrderFormConfig = JSON.parse(configEl?.textContent ?? '{}');

  // The calculator's basket is the whole menu with a stepper on every line, so
  // a row exists even at quantity zero. (Checkout's basket is the opposite:
  // only what the customer actually added.) This adapter is the ONLY thing the
  // two pages do differently — everything past it is shared by order-form.ts.
  const itemRows = Array.from(document.querySelectorAll<HTMLElement>('.item-row'));

  const qtyEl = (row: HTMLElement) => row.querySelector('.qty-value') as HTMLElement;
  const minusOf = (row: HTMLElement) => row.querySelector('.qty-minus') as HTMLButtonElement;
  const plusOf = (row: HTMLElement) => row.querySelector('.qty-plus') as HTMLButtonElement;

  /**
   * What each line costs at full price, captured before any offer is applied.
   *
   * `row.price` gets overwritten with the offer price when one is running, so
   * without this there is nothing left to strike through — and no way to tell
   * an offer ending from a price rise.
   */
  const normalPrice = new Map<string, number>(
    itemRows.map((row) => [row.dataset.id as string, Number(row.dataset.price)]),
  );
  const priceEl = (row: HTMLElement) => row.querySelector('.item-row-price') as HTMLElement;
  const bareCode = (id: string) => id.replace(/^(item|combo|addon)-/, '');

  const rows: BasketRow[] = itemRows.map((row) => ({
    id: row.dataset.id,
    name: row.dataset.name as string,
    price: Number(row.dataset.price),
    normalPrice: undefined as number | undefined,
    lateNight: row.dataset.lateNight === 'true',
    getQty: () => Number(qtyEl(row).textContent) || 0,
    setQty(n: number) {
      qtyEl(row).textContent = String(n);
      minusOf(row).disabled = n === 0;
    },
    setUnavailable(off: boolean) {
      row.classList.toggle('item-row--unavailable', off);
      plusOf(row).disabled = off;
      if (off) minusOf(row).disabled = true;
    },
  }));

  // This page works out a total; it does not take orders. Sending from here
  // produced an order with no name and no callback number, so the primary
  // button now carries the basket to /checkout/, which asks for both. Copy
  // quote stays — it is how the kitchen quotes a price over the phone.
  const form = initOrderForm(CFG, {
    rows: () => rows,
    primaryAction: 'handoff',
    handoffHref: '/checkout/',
    onHandoff() {
      // Write what was picked here into the basket, so checkout opens already
      // filled in. Quantities are SET, not added: this screen is the basket the
      // customer just built, and adding to whatever was already there would
      // silently double it. Extras attached to a line at checkout survive,
      // because setItemQty only touches the quantity.
      const chosen = new Map<string, number>();
      itemRows.forEach((row, i) => {
        const qty = rows[i].getQty();
        if (qty > 0) chosen.set(row.dataset.id as string, qty);
      });
      for (const line of getCart()) {
        if (!chosen.has(line.id)) continue;
        setItemQty(line.id, chosen.get(line.id) as number);
        chosen.delete(line.id);
      }
      for (const [id, qty] of chosen) setItemQty(id, qty);
    },
  });

  /**
   * Ask the Worker what the kitchen has run out of, and keep asking.
   *
   * This page had no idea about stock at all: Coca-Cola was marked sold out in
   * the admin, the menu crossed it out, and the calculator went on selling it
   * straight through to checkout (owner-reported, 2026-08-20). Same cadence as
   * the menu's own poll - a minute, plus whenever someone comes back to the tab
   * - because a sold-out tray is a fact about right now, not about page load.
   */
  /**
   * Put live offer prices on the calculator.
   *
   * This page quoted the full price while an offer was running — ₹189 for a
   * pizza actually selling at ₹139 (owner, 2026-08-25). It over-quoted, which
   * is the safe direction to be wrong in, but it hid the offer from the one
   * screen built for comparing prices.
   *
   * The strike-through matters as much as the number: "₹139" alone gives a
   * customer no way to tell a deliberate offer from a wrong price, which is the
   * same reasoning checkout uses.
   */
  function applyOffers(live: Record<string, { price: number; label: string | null }>) {
    itemRows.forEach((el, i) => {
      const id = el.dataset.id as string;
      const normal = normalPrice.get(id) ?? Number(el.dataset.price);
      const offer = live[bareCode(id)];
      const onOffer = offer !== undefined && offer.price < normal;
      const next = onOffer ? offer.price : normal;

      rows[i].price = next;
      // Only set when an offer is actually running — order-form.ts reads this
      // to decide what is discounted, and a value that is always present would
      // make every line look like an offer.
      rows[i].normalPrice = onOffer ? normal : undefined;

      const cell = priceEl(el);
      if (!cell) return;
      cell.textContent = '';
      if (onOffer) {
        const was = document.createElement('span');
        was.className = 'price-was';
        was.textContent = `₹${normal}`;
        cell.appendChild(was);
      }
      cell.appendChild(document.createTextNode(`₹${next}`));
    });
  }

  function refreshSoldOut() {
    if (!CFG.workerUrl) return;
    fetch(`${CFG.workerUrl}/availability`)
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (!d || !d.ok) return;
        form.setSoldOut(Object.keys(d.sold_out ?? {}));
        applyOffers(d.offers ?? {});
        form.update();
      })
      .catch(() => {
        // Everything stays orderable. AGENTS.md rule 5 - a backend that cannot
        // be reached must never stop somebody ordering.
      });
  }

  refreshSoldOut();
  window.setInterval(refreshSoldOut, 60000);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') refreshSoldOut();
  });
  window.addEventListener('pageshow', (e) => {
    if ((e as PageTransitionEvent).persisted) refreshSoldOut();
  });

  rows.forEach((r, i) => {
    minusOf(itemRows[i]).addEventListener('click', () => {
      r.setQty(Math.max(0, r.getQty() - 1));
      form.update();
    });
    plusOf(itemRows[i]).addEventListener('click', () => {
      r.setQty(r.getQty() + 1);
      form.update();
    });
  });
</script>
