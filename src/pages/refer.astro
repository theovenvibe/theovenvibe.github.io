---
/**
 * /refer — invite a friend, both get ₹40.
 *
 * The share button opens WhatsApp with the message already written and sends it
 * FROM the customer TO their friend. That direction matters: an unsolicited
 * message from our business number can get the account reported, while one
 * person telling a friend about a pizza is just a conversation.
 *
 * The code only exists after someone has ordered, so this page has two states
 * and both are honest — a visitor with no code is told plainly that ordering
 * once is what unlocks it, rather than being shown a dead button.
 */
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/data';
import { restaurantJsonLd } from '../lib/seo';

const workerUrl = site.backend.worker_url ?? '';

const title = 'Refer a friend — you both get ₹40 | The Oven Vibe';
const description =
  'Share your code. When your friend places their first order, you both get ₹40 of Dough at The Oven Vibe, Sundargarh.';
---

<Layout title={title} description={description} jsonLd={[restaurantJsonLd({ withMenu: false })]}>
  <main class="main">
    <section class="section">
      <div class="container narrow-container">
        <header class="dough-hero">
          <div class="dough-mark">
            <img src="/static/images/svg/dough.svg" alt="" width="120" height="120" />
          </div>
          <p class="dough-eyebrow">Refer</p>
          <h1 class="dough-title">Refer a friend.<br />Earn ₹40 in Dough.</h1>
          <p class="dough-lede">
            Send them your link. They get <strong>₹40 off their first order</strong>, and
            <strong>₹40 in Dough</strong> lands with you the moment it is delivered.
          </p>
        </header>

        <div class="refer-card" id="referCard" hidden>
          <p class="refer-label">Your code</p>
          <p class="refer-code" id="referCode">—</p>
          <button type="button" class="btn btn-primary btn-lg" id="referShare">
            Share on WhatsApp
          </button>
          <button type="button" class="btn btn-secondary" id="referCopy">Copy the link</button>
          <p class="refer-link" id="referLink"></p>
        </div>

        <div class="refer-card refer-locked" id="referLocked">
          <p>
            Your code appears here after your first order — it is tied to your phone number, so
            there is nothing to sign up for.
          </p>
          <a href="/#menu" class="btn btn-primary btn-lg">See the menu</a>
        </div>

        <div class="dough-steps">
          <div class="dough-step">
            <span class="dough-step-n">1</span>
            <h2>Send your link</h2>
            <p>One tap opens WhatsApp with the message ready. Send it to whoever you like.</p>
          </div>
          <div class="dough-step">
            <span class="dough-step-n">2</span>
            <h2>They order</h2>
            <p>₹40 comes off their first order of ₹399 or more. They do not need a code — the link does it.</p>
          </div>
          <div class="dough-step">
            <span class="dough-step-n">3</span>
            <h2>You both get ₹40</h2>
            <p>
              Yours lands as Dough when their food is delivered — a real order, not a click.
            </p>
          </div>
        </div>

        <h2 class="dough-h2">Questions</h2>
        <div class="dough-faq">
          <details>
            <summary>How many friends can I invite?</summary>
            <p>As many as you like. Each one earns you ₹40 on their first order.</p>
          </details>
          <details>
            <summary>When exactly do I get my ₹40?</summary>
            <p>
              When their order is delivered and paid for — not when they click the link. If their
              order is cancelled, the reward goes with it.
            </p>
          </details>
          <details>
            <summary>Can I invite someone who has ordered before?</summary>
            <p>
              The reward is for bringing someone new, so it only works for a number that has not
              ordered from us before.
            </p>
          </details>
          <details>
            <summary>How do I spend the ₹40?</summary>
            <p>
              It becomes Dough, which comes off your next bill automatically — up to 10% of an
              order. <a href="/dough/">How Dough works</a>.
            </p>
          </details>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script define:vars={{ workerUrl }}>
  import { getDeviceId } from '../lib/device';

  const card = document.getElementById('referCard');
  const locked = document.getElementById('referLocked');
  const codeEl = document.getElementById('referCode');
  const linkEl = document.getElementById('referLink');
  const shareBtn = document.getElementById('referShare');
  const copyBtn = document.getElementById('referCopy');

  /**
   * Checkout stores the code from the order reply, so the usual path needs no
   * request at all. If it is missing we ask the Worker once, keyed on this
   * device — that covers everyone who ordered before checkout started reading
   * the reply, which was every customer up to 2026-08-19.
   */
  // A private link the owner sent them: /refer/?t=<token>, the same token that
  // opens their Dough statement. It wins over the cache, because it is an
  // explicit "show me MY code" — and it is the only route for someone whose
  // browser we have never seen, which is anyone whose order we failed to file.
  const token = new URLSearchParams(location.search).get('t');
  const cached = localStorage.getItem('ov_my_referral_code');

  function show(code) {
    if (!card || !locked || !codeEl || !linkEl) return;
    const url = `${location.origin}/?r=${code}`;
    codeEl.textContent = code;
    linkEl.textContent = url;
    card.hidden = false;
    locked.hidden = true;

    const message = `I order from The Oven Vibe in Sundargarh — proper oven-baked pizza 🍕\n\nUse my link and you get ₹40 off your first order: ${url}`;

    shareBtn?.addEventListener('click', () => {
      // wa.me with no number opens the contact picker, so the customer chooses
      // who to send it to — the message travels between two friends, which is
      // the only direction that does not risk our business number.
      window.open(`https://wa.me/?text=${encodeURIComponent(message)}`, '_blank', 'noopener');
    });

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        copyBtn.textContent = 'Copied';
        window.setTimeout(() => (copyBtn.textContent = 'Copy the link'), 2000);
      } catch {
        // Clipboard is blocked in some in-app browsers; the link is on screen
        // to select by hand, so this is not worth an error message.
      }
    });
  }

  if (cached && !token) {
    show(cached);
  } else {
    // Silent on failure: the honest "order once first" state is already on
    // screen, and it is the right thing to show someone we cannot identify.
    fetch(
      `${workerUrl}/referral/mine?` +
        (token ? `t=${encodeURIComponent(token)}` : `device_id=${encodeURIComponent(getDeviceId())}`),
    )
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => {
        if (!data?.referral_code) return;
        localStorage.setItem('ov_my_referral_code', data.referral_code);
        show(data.referral_code);
      })
      .catch(() => {});
  }
</script>
