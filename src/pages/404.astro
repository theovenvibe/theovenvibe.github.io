---
// 404 — recovery page per PRD §4.
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/data';
---

<Layout
  title={`Page not found — ${site.business.name}`}
  description="That page doesn't exist — but the menu does."
>
  <main class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="text-4xl font-bold">404 — that page got eaten 🍕</h1>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/menu/" class="rounded-full bg-amber-500 px-6 py-3 font-semibold text-neutral-950"
        >See the Menu</a
      >
      <a
        href={`tel:${site.business.phone}`}
        class="rounded-full border border-neutral-600 px-6 py-3 font-semibold"
        aria-label={`Call ${site.business.name} at ${site.business.phone_display}`}>Call Us</a
      >
    </div>
  </main>
</Layout>
