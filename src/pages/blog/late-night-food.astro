---
// Ported verbatim from v1's blog-late-night-food.html (PRD §8 superseded
// block). Route is the AGENTS.md-bound slug /blog/late-night-food/.
import Layout from '../../layouts/Layout.astro';
import BlogPostLayout from '../../components/BlogPostLayout.astro';
import { site } from '../../lib/data';

const title = `Best Late-Night Food in Sundargarh | Order After 9 PM – ${site.business.name}`;
const description =
  'Looking for late-night food in Sundargarh? Discover the best pizzas and quick bites to order after 9 PM. Fresh, affordable, and perfect for night cravings by The Oven Vibe.';
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/static/images/blog_images/blog_3.webp', Astro.site).toString();
const waLink = `https://wa.me/${site.business.whatsapp}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: 'Best Late-Night Food in Sundargarh | Order After 9 PM',
  image: ogImage,
  author: { '@type': 'Organization', name: site.business.name },
  publisher: {
    '@type': 'Organization',
    name: site.business.name,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/static/images/brand_images/The%20Oven%20vibe_logo.webp', Astro.site).toString(),
    },
  },
  datePublished: '2024-05-25',
  description:
    'Looking for late-night food in Sundargarh? Discover the best pizzas and quick bites to order after 9 PM.',
};
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="late night food in Sundargarh, late night pizza Sundargarh, food open at night Sundargarh, best pizza after 9 PM Sundargarh, The Oven Vibe late night, affordable late night food Sundargarh"
    />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Looking for late-night food in Sundargarh? Discover the best pizzas and quick bites to order after 9 PM."
    />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <BlogPostLayout
    line1="LATE-NIGHT"
    lineGradient="FOOD."
    subtitle="Best late-night food options in Sundargarh for cravings after 9 PM."
  >
    <h2>Best Late-Night Food in Sundargarh 🌙</h2>
    <p class="subtitle" style="font-weight: 600; color: #555; margin-top: -10px">
      Raat ke time kya order karein?
    </p>

    <picture>
      <source type="image/avif" srcset="/static/images/blog_images/blog_3.avif" />
      <source type="image/webp" srcset="/static/images/blog_images/blog_3.webp" />
      <img
        src="/static/images/blog_images/blog_3.webp"
        alt="Best Late-Night Food in Sundargarh"
        class="blog-img"
        loading="lazy"
        width="1200"
        height="675"
        style="background: #eee"
      />
    </picture>

    <p>
      Sundargarh mein jaise hi clock 9 bajta hai, bhook aur zyada dangerous ho jaati hai 😄 Options
      kam ho jaate hain, lekin craving full power mein hoti hai. Aise time pe chahiye fresh, tasty
      aur fast food 🍕
    </p>

    <h3>Why Late-Night Food Matters 🌃</h3>
    <p>Late-night food sirf hunger nahi, mood bhi fix karta hai 😌</p>
    <p><strong>Late-night orders ka scene:</strong></p>
    <ul>
      <li>Hostel students & bachelors</li>
      <li>Night shift workers</li>
      <li>Movie nights & gaming sessions 🎮</li>
      <li>Sudden midnight hunger 😄</li>
    </ul>

    <h3>Most Ordered Late-Night Foods in Sundargarh 🍴</h3>
    <p>Raat ke time log heavy nahi, comfort food prefer karte hain.</p>
    <p><strong>Top Late-Night Choices:</strong></p>
    <ul>
      <li>Fresh pizzas 🍕</li>
      <li>Garlic breads & sides</li>
      <li>Light but filling meals</li>
    </ul>

    <h3>The Oven Vibe – Late-Night Favorite 🍕🔥</h3>
    <p>
      Cloud kitchen hone ki wajah se yahan freshly prepared food milta hai—no reheating, no
      compromise 💯
    </p>

    <p><strong>Must-Try Late-Night Pizzas:</strong></p>
    <ul>
      <li><strong>Paneer Makhni Royale Pizza</strong> – creamy & comforting</li>
      <li><strong>Herb Paneer Delight Pizza</strong> – light and flavorful</li>
      <li><strong>Mushroom Supreme Pizza</strong> – perfect for night cravings</li>
      <li><strong>Vegie Onion Capsicum Pizza</strong> – simple & satisfying</li>
    </ul>

    <div class="highlight-box">
      <h3>Why People Love Ordering Late Night from Us:</h3>
      <ul style="list-style: none; padding-left: 0;">
        <li>✔ Fresh food, even at night</li>
        <li>✔ Pocket-friendly pricing</li>
        <li>✔ Perfect for sharing</li>
      </ul>
      <p style="margin-top: 10px; font-weight: 700; color: #ad210a">Price for Two: Under ₹350</p>
    </div>

    <h3>Late-Night Ordering Tips 💡</h3>
    <ul>
      <li>9–10 PM ke beech order karo for faster prep</li>
      <li>WhatsApp ordering quick hota hai 📲</li>
      <li>Light toppings = better night comfort 😄</li>
    </ul>

    <h3>Final Bite 🌙😋</h3>
    <p>
      Raat ho ya din, bhook ka solution simple hai—fresh, tasty aur affordable food 🍕 Aur jab
      late-night craving hit kare, The Oven Vibe is always ready to serve the vibe 🔥
    </p>

    <a href={waLink} target="_blank" class="cta">
      👉 Order now on WhatsApp & enjoy fresh late-night food in Sundargarh
    </a>
  </BlogPostLayout>
</Layout>
