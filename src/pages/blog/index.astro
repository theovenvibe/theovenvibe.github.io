---
// Blog index — v1's blog.html layout with Phase 4 copy/SEO.
import Layout from '../../layouts/Layout.astro';
import { site, heroDish, galleryFor, displayName } from '../../lib/data';
import { abs, breadcrumbJsonLd, organization } from '../../lib/seo';

const title = 'Sundargarh Food Stories & Guides | The Oven Vibe';
const festivalPhoto = galleryFor(heroDish)[0];
const description =
  'Local food guides from Sundargarh: budget pizza picks, late-night options, how cloud kitchens work, and why The Oven Vibe cooks 100% pure veg.';

const blogJsonLd = {
  '@type': 'Blog',
  '@id': `${abs('/blog/')}#blog`,
  name: `${site.business.name} Blog`,
  description,
  url: abs('/blog/'),
  inLanguage: 'en-IN',
  publisher: organization,
};
---

<Layout
  title={title}
  description={description}
  jsonLd={[blogJsonLd, breadcrumbJsonLd([{ name: 'Blog', path: '/blog/' }])]}
>

  <!-- MAIN BLOG CONTAINER -->
  <div class="main">
    <!-- HERO SECTION -->
    <section class="hero hero-mini">
      <div class="hero-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
      </div>
      <div class="hero-container">
        <div class="hero-content">
          <h1 class="hero-display" style="font-size: clamp(2rem, 5vw, 4rem);">
            <span class="animate-on-scroll">FOOD</span>
            <span class="text-gradient animate-on-scroll delay-100">STORIES.</span>
          </h1>
          <p class="hero-text animate-on-scroll delay-200">
            Food choices and ordering guides from our own kitchen in Sundargarh.
          </p>
        </div>
      </div>
    </section>

    <div class="section" style="padding-top: 0;">
      <div class="container">
        <h2 class="sr-only">All stories</h2>
        <div class="blog-grid">
          {[{title:'Diwali 2026: plan the food for your gathering',path:'/blog/diwali-party-menu/',text:'Compare real menu choices, servings, ingredient preferences and the final group-order quote.'},{title:'Durga Puja: choose food around your preferences',path:'/blog/durga-puja-food/',text:'Current seasonal dishes, ingredient preferences, and collection or delivery planning.'}].map(post=><article class="blog-card"><div class="blog-card-img-wrapper"><img src={festivalPhoto.webp} alt={displayName(heroDish.display_name)} class="blog-card-img" width="600" height="400" loading="lazy"/></div><div class="blog-card-content"><h3>{post.title}</h3><p>{post.text}</p><a href={post.path} class="read-more">Read the guide →</a></div></article>)}
          <!-- Blog Card 5 (Newest) -->
          <article class="blog-card animate-on-scroll delay-200">
            <div class="blog-card-img-wrapper">
              <picture>
                <source type="image/avif" srcset="/static/images/blog_images/blog_5.avif" />
                <source type="image/webp" srcset="/static/images/blog_images/blog_5.webp" />
                <img
                  src="/static/images/blog_images/blog_5.webp"
                  alt="The Oven Vibe food photograph"
                  class="blog-card-img"
                  loading="lazy"
                  width="400"
                  height="225"
                />
              </picture>
            </div>
            <div class="blog-card-content">
              <h3>How Our Cloud Kitchen Orders Work</h3>
              <p>
                Discover why cloud kitchens are changing the food scene in Sundargarh. Faster
                delivery, affordable pricing, and fresh food.
              </p>
              <a
                href="/blog/cloud-kitchen-future/"
                class="read-more"
                aria-label="Read full article: How Our Cloud Kitchen Orders Work"
                >Read Story →</a
              >
            </div>
          </article>

          <!-- Blog Card 4 -->
          <article class="blog-card animate-on-scroll delay-200">
            <div class="blog-card-img-wrapper">
              <picture>
                <source type="image/avif" srcset="/static/images/blog_images/blog_4.avif" />
                <source type="image/webp" srcset="/static/images/blog_images/blog_4.webp" />
                <img
                  src="/static/images/blog_images/blog_4.webp"
                  alt="Pure veg pizza under 300 rupees in Sundargarh"
                  class="blog-card-img"
                  loading="lazy"
                  width="400"
                  height="225"
                />
              </picture>
            </div>
            <div class="blog-card-content">
              <h3>Pizza Under ₹300 in Sundargarh | Student Specials</h3>
              <p>
                Looking for pizza under ₹300? Discover budget-friendly student pizza options that
                are tasty and filling.
              </p>
              <a
                href="/blog/pizza-under-300/"
                class="read-more"
                aria-label="Read full article: Pizza Under ₹300 in Sundargarh"
                >Read Story →</a
              >
            </div>
          </article>

          <!-- Blog Card 3 -->
          <article class="blog-card animate-on-scroll delay-200">
            <div class="blog-card-img-wrapper">
              <picture>
                <source type="image/avif" srcset="/static/images/blog_images/blog_3.avif" />
                <source type="image/webp" srcset="/static/images/blog_images/blog_3.webp" />
                <img
                  src="/static/images/blog_images/blog_3.webp"
                  alt="Late-night food in Sundargarh — ordering till 2 AM"
                  class="blog-card-img"
                  loading="lazy"
                  width="400"
                  height="225"
                />
              </picture>
            </div>
            <div class="blog-card-content">
              <h3>Late-Night Menu, Charges & Orders</h3>
              <p>
                Late-night cravings? We cook till 2 AM in Sundargarh — pizzas, sandwiches and fries,
                with the late-night charges spelled out.
              </p>
              <a
                href="/blog/late-night-food/"
                class="read-more"
                aria-label="Read full article: Late-Night Menu, Charges & Orders"
                >Read Story →</a
              >
            </div>
          </article>

          <!-- Blog Card: pure veg / eggless -->
          <article class="blog-card animate-on-scroll delay-100">
            <div class="blog-card-img-wrapper">
              <picture>
                <source type="image/avif" srcset="/static/images/blog_images/blog_5.avif" />
                <source type="image/webp" srcset="/static/images/blog_images/blog_5.webp" />
                <img
                  src="/static/images/blog_images/blog_5.webp"
                  alt="Pure veg eggless pizza in Sundargarh"
                  class="blog-card-img"
                  loading="lazy"
                  width="400"
                  height="225"
                />
              </picture>
            </div>
            <div class="blog-card-content">
              <h3>Is It Really Pure Veg? No Egg, No Shared Kitchen</h3>
              <p>
                Every item is 100% pure veg and completely eggless — base, mayo and dips — and no
                non-veg has ever been cooked in this kitchen.
              </p>
              <a
                href="/blog/pure-veg-no-egg/"
                class="read-more"
                aria-label="Read full article: Is It Really Pure Veg? No Egg, No Shared Kitchen"
                >Read Story →</a
              >
            </div>
          </article>

          <!-- Blog Card 2 -->
          <article class="blog-card animate-on-scroll delay-200">
            <div class="blog-card-img-wrapper">
              <picture>
                <source type="image/avif" srcset="/static/images/blog_images/blog_2.avif" />
                <source type="image/webp" srcset="/static/images/blog_images/blog_2.webp" />
                <img
                  src="/static/images/blog_images/blog_2.webp"
                  alt="Veg versus non-veg pizza in Sundargarh"
                  class="blog-card-img"
                  loading="lazy"
                  width="400"
                  height="225"
                />
              </picture>
            </div>
            <div class="blog-card-content">
              <h3>Veg vs Non-Veg Pizza in Sundargarh</h3>
              <p>
                What pure vegetarian and egg-free mean here, and how they differ from vegan or no-onion preferences.
              </p>
              <a
                href="/blog/veg-vs-non-veg/"
                class="read-more"
                aria-label="Read full article: Veg vs Non-Veg Pizza in Sundargarh"
                >Read Story →</a
              >
            </div>
          </article>

          <!-- Blog Card 1 -->
          <article class="blog-card animate-on-scroll delay-200">
            <div class="blog-card-img-wrapper">
              <picture>
                <source type="image/avif" srcset="/static/images/blog_images/blog_1.avif" />
                <source type="image/webp" srcset="/static/images/blog_images/blog_1.webp" />
                <img
                  src="/static/images/blog_images/blog_1.webp"
                  alt="Affordable pizza spots in Sundargarh"
                  class="blog-card-img"
                  loading="lazy"
                  width="400"
                  height="225"
                />
              </picture>
            </div>
            <div class="blog-card-content">
              <h3>Plan a Pizza Budget in Sundargarh</h3>
              <p>
                Compare our current pizza baskets and ordering charges so you can
                compare the final bill before ordering.
              </p>
              <a
                href="/blog/affordable-pizza/"
                class="read-more"
                aria-label="Read full article: Plan a Pizza Budget in Sundargarh"
                >Read Story →</a
              >
            </div>
          </article>
        </div>
      </div>
    </div>
  </div>
</Layout>
