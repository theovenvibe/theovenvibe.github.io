---
import Layout from '../../layouts/Layout.astro';
import BlogPostLayout from '../../components/BlogPostLayout.astro';
import { availableItems, displayName, displayDescription } from '../../lib/data';
import { abs, blogPostingJsonLd, breadcrumbJsonLd, itemUrl } from '../../lib/seo';
const headline = 'What Pure Veg Means Here | The Oven Vibe';
const description = 'Our pure vegetarian, egg-free kitchen policy, the difference from vegan and no-onion food, and how to choose from the actual menu.';
const path = '/blog/veg-vs-non-veg/';
const image = {url:abs('/static/images/og/blog_2.jpg'),width:1200,height:630,alt:'The Oven Vibe food photograph'};
const picks=availableItems.filter(i=>['752649876','745802364','900000007'].includes(i.product_code));
---
<Layout title={headline} description={description} ogType="article" image={image} jsonLd={[blogPostingJsonLd({headline,description,path,image:image.url,datePublished:'2024-05-20',dateModified:'2026-10-17'}),breadcrumbJsonLd([{name:'Blog',path:'/blog/'},{name:headline,path}])]}>
 <BlogPostLayout line1='PURE VEG,' lineGradient='CLEARLY EXPLAINED.' subtitle='Our kitchen policy and the menu details worth checking.'>
  <picture><source type="image/avif" srcset="/static/images/blog_images/blog_2.avif"/><source type="image/webp" srcset="/static/images/blog_images/blog_2.webp"/><img src="/static/images/blog_images/blog_2.webp" alt="The Oven Vibe food photograph" class="blog-img" loading="lazy" width="1024" height="1024"/></picture>

  <p>The Oven Vibe serves a 100% pure vegetarian, egg-free menu. This page explains our own kitchen policy; it is not a ranking of vegetarian and other diets or a nutrition study.</p>
  <h2>What does pure veg mean at this kitchen?</h2><p>We do not prepare non-vegetarian dishes or egg dishes. The menu uses ingredients such as paneer, cheese, vegetables and egg-free sauces. You do not need to find a separate vegetarian corner of the menu.</p>
  <h2>Vegetarian, vegan and no-onion are different requests</h2><p>Paneer, cheese, milk and cream are dairy, so vegetarian does not mean vegan. Regular dishes can contain onion and garlic. Only an item explicitly described without those ingredients should be considered for that preference, and seasonal specials are not a universal fasting certification.</p>
  <h2>Three actual pizza descriptions to compare</h2><ul>{picks.map(i=><li><a href={itemUrl(i.product_code)}><strong>{displayName(i.display_name)}</strong></a>: {displayDescription(i)}</li>)}</ul>
  <h2>Check allergy requirements before ordering</h2><p>Pure veg does not mean free from wheat, milk, nuts or other allergens. Descriptions are not complete allergen declarations. Contact the kitchen before ordering if you need to avoid a particular ingredient; we do not promise an allergen-free preparation environment.</p>
  <h2>Use the serving details too</h2><p>Regular Classic Favorite pizzas are listed as 7-inch, while the regular Signature pizzas describe 8-inch pizzas cut into four slices. A Mega Jumbo Melt is one sandwich cut into four pieces. Ingredient preference and serving size are separate decisions.</p>

  <p><a href="/choose/">Compare ingredients, serving sizes and combos</a>, <a href="/menu/">browse the full menu</a>, or <a href="/faq/">read the ordering answers</a>.</p>
 </BlogPostLayout>
</Layout>
