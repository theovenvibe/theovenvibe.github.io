---
/**
 * /dough — what the currency is, in the customer's terms.
 *
 * Deliberately says nothing about food cost, margin, redemption rates or how
 * the reward is funded. That is our business and it is in the backend's docs;
 * a customer needs four facts — you earn it, you spend it, here is the limit,
 * here is when it goes.
 *
 * The honest bits are stated plainly rather than buried, because a loyalty
 * scheme that hides its rules is one people stop trusting the first time a
 * number surprises them: the 10% cap and the 45-day expiry are both above the
 * fold, in the same size as everything else.
 */
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/data';
import { restaurantJsonLd } from '../lib/seo';
const workerUrl = site.backend.worker_url ?? '';

const title = 'Dough — earn 5% back on every order | The Oven Vibe';
const description =
  'Order from The Oven Vibe and earn 5% back in Dough. It comes off your next bill automatically — nothing to type, no code to remember.';
---

<Layout title={title} description={description} jsonLd={[restaurantJsonLd({ withMenu: false })]}>
  <main class="main">
    <section class="section">
      {/*
        The customer's own statement, shown only when they arrive with the link
        the owner pasted into their chat. Without a token this is invisible and
        the page reads exactly as before - the pitch, not an account.

        It is gated on a token rather than a phone number on purpose: a bare
        number would let anyone read what a neighbour ordered.
      */}
      <div class="wrap" id="myDough" hidden>
        <div class="dough-statement">
          <p class="dough-statement-label">Your Dough</p>
          <p class="dough-statement-balance" id="myDoughBalance">—</p>
          <p class="dough-statement-note" id="myDoughNote"></p>
          <ol class="dough-statement-list" id="myDoughList"></ol>
          <p class="dough-small" id="myDoughEmpty" hidden>
            Nothing yet. Your first order will show up here.
          </p>
        </div>
      </div>
      {/*
        The hero.

        Everything above the fold answers one question - "how much Dough do I
        have?" - and the mark answers it. The ball of dough already carries a
        rupee pressed into it, so the balance sits UNDER the mark rather than
        on top of it; stacking a number over that glyph collides with the one
        piece of the brand this page is about.

        The number is the only thing that animates, and only when it arrives.
      */}
      <div class="container narrow-container">
        <header class="dough-hero">
          <div class="dough-mark" id="doughMark" data-state="idle">
            <img src="/static/images/svg/dough.svg" alt="" width="120" height="120" />
          </div>

          <p class="dough-eyebrow">Dough</p>
          <h1 class="dough-title">Order. Earn Dough.<br />Use it on your next order.</h1>
          <p class="dough-lede">
            Every order you place earns you <strong>5% back in Dough</strong>. It comes off your
            next bill on its own — nothing to type, no code to remember.
          </p>

          <div class="dough-balance" id="doughBalance" hidden>
            <p class="dough-balance-amount"><span id="doughBalanceValue">₹0</span></p>
            <p class="dough-balance-note" id="doughBalanceNote"></p>
            <p class="dough-balance-expiry" id="doughBalanceExpiry" hidden></p>
          </div>

          <form class="dough-check" id="doughCheckForm">
            <label class="dough-check-label" for="doughCheckPhone">
              Already ordered? See your Dough
            </label>
            <div class="dough-check-control">
              <input
                id="doughCheckPhone"
                name="phone"
                type="tel"
                inputmode="numeric"
                autocomplete="tel"
                maxlength="15"
                placeholder="Your mobile number"
                required
              />
              <button type="submit" class="dough-check-btn" id="doughCheckBtn">
                <span class="dough-check-btn-text">Check</span>
              </button>
            </div>
            <p class="dough-check-result" id="doughCheckResult" role="status" hidden></p>
          </form>
        </header>
      </div>

      <script is:inline define:vars={{ workerUrl }}>
        // Check a balance by number. Deliberately its own endpoint: /dough/balance
        // is polled by the floating button on every page, and the kitchen only
        // wants to hear about someone who actually asked.
        (() => {
          const form = document.getElementById('doughCheckForm');
          const input = document.getElementById('doughCheckPhone');
          const btn = document.getElementById('doughCheckBtn');
          const btnText = btn.querySelector('.dough-check-btn-text');
          const out = document.getElementById('doughCheckResult');
          const mark = document.getElementById('doughMark');
          const panel = document.getElementById('doughBalance');
          const value = document.getElementById('doughBalanceValue');
          const note = document.getElementById('doughBalanceNote');
          if (!form || !workerUrl) return;

          const saved = (() => { try { return localStorage.getItem('ov_phone') || ''; } catch { return ''; } })();
          if (saved) input.value = saved;

          const say = (text, bad) => {
            out.textContent = text;
            out.hidden = !text;
            out.classList.toggle('is-bad', Boolean(bad));
          };

          const stillMoment = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          /* The balance counts up rather than appearing, because the number IS
             the answer and a number that lands has more weight than one that
             was always there. Short - 600ms - and skipped entirely for anyone
             who has asked for less motion. */
          const countTo = (target) => {
            if (stillMoment || target <= 0) {
              value.textContent = '₹' + target;
              return;
            }
            const started = performance.now();
            const tick = (now) => {
              const t = Math.min(1, (now - started) / 600);
              const eased = 1 - Math.pow(1 - t, 3);
              value.textContent = '₹' + Math.round(target * eased);
              if (t < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          };

          const reveal = (balance, name, expiresAt) => {
            panel.hidden = false;
            mark.dataset.state = balance > 0 ? 'full' : 'empty';
            countTo(balance);
            // Two lines, not one joined by a dot: the first is what they can do
            // with it, the second is a deadline. Running them together made the
            // deadline read as a footnote to the permission.
            note.textContent =
              balance > 0 ? 'Ready to use on your next order' : 'You earn 5% back on your next order';
            const expiry = document.getElementById('doughBalanceExpiry');
            if (balance > 0 && expiresAt) {
              expiry.textContent =
                'Good until ' +
                new Date(expiresAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
              expiry.hidden = false;
            } else {
              expiry.hidden = true;
            }
            say(name ? name + ', this is your Dough.' : '', false);
          };

          const deviceId = () => {
            try {
              const k = 'ovenvibe.device_id.v1';
              let id = localStorage.getItem(k);
              if (!id) { id = crypto.randomUUID(); localStorage.setItem(k, id); }
              return id;
            } catch { return null; }
          };

          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const digits = (input.value || '').replace(/\D/g, '').slice(-10);
            if (!/^[6-9]\d{9}$/.test(digits)) {
              say('That does not look like a 10-digit mobile number.', true);
              input.focus();
              return;
            }
            btn.disabled = true;
            btn.dataset.busy = 'true';
            btnText.textContent = 'Checking';
            say('', false);
            try {
              const res = await fetch(`${workerUrl}/dough/lookup`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                // Same key as src/lib/device.ts — this script is `is:inline`
                // so it cannot import it, but it must never mint a second id:
                // the whole point is that this browser's balance check ties to
                // the same device the order POST uses.
                body: JSON.stringify({ phone: digits, device_id: deviceId() }),
              });
              const data = await res.json();
              if (!data.ok) {
                say(data.error || 'Something went wrong. Try again in a moment.', true);
                return;
              }
              if (!data.found) {
                panel.hidden = true;
                mark.dataset.state = 'idle';
                say('No Dough on that number yet. It starts with your first order.', false);
                return;
              }
              // Remember it, so the Dough button recognises this browser from
              // now on - that button is how people find their balance later.
              try { localStorage.setItem('ov_phone', digits); } catch {}
              try { sessionStorage.setItem('ov_dough_balance', String(data.balance)); } catch {}
              window.dispatchEvent(new CustomEvent('ov:dough', { detail: { balance: data.balance } }));
              reveal(data.balance, data.name, data.expires_at);
            } catch {
              say('Could not reach us just now. Check your connection and try again.', true);
            } finally {
              btn.disabled = false;
              delete btn.dataset.busy;
              btnText.textContent = 'Check';
            }
          });
        })();

        (async () => {
          const token = new URLSearchParams(location.search).get('t');
          if (!token || !workerUrl) return;
          const box = document.getElementById('myDough');
          let data;
          try {
            const res = await fetch(workerUrl + '/dough/mine?t=' + encodeURIComponent(token));
            data = await res.json();
          } catch (e) {
            return; // A statement that will not load must never break the page.
          }
          if (!data || !data.ok) return;

          const rupees = (n) => '₹' + Math.abs(n);
          const day = (iso) =>
            new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' });

          document.getElementById('myDoughBalance').textContent = rupees(data.balance);
          document.getElementById('myDoughNote').textContent =
            (data.name ? data.name + ' · ' : '') +
            (data.balance > 0 && data.expires_at
              ? 'use it before ' + day(data.expires_at)
              : 'earn 5% back on your next order');

          const list = document.getElementById('myDoughList');
          const label = {
            earn: 'Earned from your order',
            spend: 'Used on your order',
            gift: 'A gift from us',
            referral: 'Friend referral',
            expire: 'Expired',
            reversal: 'Taken back',
          };
          for (const e of data.entries) {
            const li = document.createElement('li');
            const what = label[e.kind] || e.kind;
            const order = e.order_id ? ' · order #' + String(e.order_id).padStart(4, '0') : '';
            li.innerHTML =
              '<span class="dough-statement-amount' + (e.delta < 0 ? ' is-out' : '') + '">' +
              (e.delta > 0 ? '+' : '−') + rupees(e.delta) + '</span>' +
              '<span class="dough-statement-what">' + what +
              '<span class="dough-statement-when">' + day(e.at) + order +
              (e.order_total ? ' · ' + rupees(e.order_total) + ' order' : '') + '</span></span>';
            list.appendChild(li);
          }
          if (!data.entries.length) document.getElementById('myDoughEmpty').hidden = false;
          box.hidden = false;
        })();
      </script>
      <div class="container narrow-container">
        <h2 class="dough-h2">How Dough works</h2>
        <div class="dough-steps">
          <div class="dough-step">
            <span class="dough-step-n">1</span>
            <h2>Order</h2>
            <p>Anything on the menu, delivery or pickup. Nothing to sign up for.</p>
          </div>
          <div class="dough-step">
            <span class="dough-step-n">2</span>
            <h2>Earn 5%</h2>
            <p>
              A ₹400 order gives you <strong>20 Dough</strong>. It lands when we hand over your
              food — that is when the order is really done.
            </p>
          </div>
          <div class="dough-step">
            <span class="dough-step-n">3</span>
            <h2>Spend it</h2>
            <p>
              Your balance comes off your next bill automatically. Nothing to type, no code to
              remember.
            </p>
          </div>
        </div>

        <h2 class="dough-h2">The two rules worth knowing</h2>
        <div class="dough-rules">
          <div class="dough-rule">
            <h3>Up to 10% of an order</h3>
            <p>
              On a ₹400 order you can use ₹40 of Dough. The rest stays in your name for next
              time — so a big balance lasts across a few orders instead of vanishing into one.
            </p>
          </div>
          <div class="dough-rule">
            <h3>45 days, and every order resets it</h3>
            <p>
              Your Dough stays as long as you order at least once every 45 days. Order today and
              the clock starts again from today. We will remind you before anything runs out.
            </p>
          </div>
        </div>

        <h2 class="dough-h2">Questions</h2>
        <div class="dough-faq">
          <details>
            <summary>Do I need an account?</summary>
            <p>
              No. Your phone number is your account. Order with the same number and your Dough
              is there.
            </p>
          </details>
          <details>
            <summary>How do I know how much I have?</summary>
            <p>
              It shows at checkout before you pay, and on the coin at the corner of this site.
              Allow notifications and we will also tell you when you earn and before anything
              expires.
            </p>
          </details>
          <details>
            <summary>Can I use Dough on an item that is already discounted?</summary>
            <p>
              One at a time — either the offer price or your Dough, whichever saves you more.
              You still earn Dough on a discounted order.
            </p>
          </details>
          <details>
            <summary>What if I cancel, or the order does not happen?</summary>
            <p>
              Any Dough you used comes straight back, and nothing is earned on an order that was
              not delivered.
            </p>
          </details>
          <details>
            <summary>Does it work on Zomato or Swiggy?</summary>
            <p>
              No — only when you order directly from us. Those apps never tell us who ordered, so
              there is no name to put the Dough against.
            </p>
          </details>
          <details>
            <summary>Can I give my Dough to someone else?</summary>
            <p>
              Not directly, but you can invite them: you both get ₹40 when they order.
              <a href="/refer/">See how that works</a>.
            </p>
          </details>
        </div>

        <div class="dough-cta">
          <a href="/#menu" class="btn btn-primary btn-lg">Start earning — see the menu</a>
          <a href="/refer/" class="btn btn-secondary btn-lg">Invite a friend</a>
        </div>

        <p class="dough-small">
          Dough has no cash value and cannot be exchanged for money. It works only on orders
          placed directly with The Oven Vibe, {site.business.address.locality}.
        </p>
      </div>
    </section>
  </main>
</Layout>
