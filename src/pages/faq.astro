---
import Layout from '../layouts/Layout.astro';
import '../styles/search-guides.css';
import { site } from '../lib/data';
import { answers, SEARCH_REVIEW_DATE } from '../lib/answers';
import { breadcrumbJsonLd, faqPageJsonLd, restaurantJsonLd, abs } from '../lib/seo';
const title = 'Food, Delivery & Ordering FAQ | The Oven Vibe';
const description = 'Direct answers about pure veg food, pizza sizes, combos, delivery, late-night charges, party orders and photographs at The Oven Vibe, Sundargarh.';
---
<Layout title={title} description={description} jsonLd={[restaurantJsonLd({withMenu:false}), faqPageJsonLd(abs('/faq/'), answers), breadcrumbJsonLd([{name:'FAQ',path:'/faq/'}])]}>
  <main class="main search-guide">
    <header class="container guide-intro">
      <p class="guide-eyebrow">The Oven Vibe · Sundargarh</p>
      <h1>Questions before you order.</h1>
      <p class="lead">Food choices, direct delivery and what happens when you send an order. These answers use our published menu and ordering rules.</p>
      <p class="guide-meta">Reviewed <time datetime={SEARCH_REVIEW_DATE}>17 October 2026</time> · Published by {site.business.name}</p>
      <nav class="guide-links" aria-label="Related guides"><a href="/choose/">Compare the menu</a><a href="/menu/">Full menu and prices</a><a href="/content-standards/">Our sources and photographs</a></nav>
    </header>
    <div class="container guide-body">
      <nav class="question-index" aria-label="Questions">{answers.map(a => <a href={`#${a.id}`}>{a.q}</a>)}</nav>
      <section aria-label="Answers" class="answer-list">
        {answers.map((a,i) => <details id={a.id} open={i===0}><summary>{a.q}</summary><p>{a.a}</p></details>)}
      </section>
      <aside class="guide-note"><h2>Need a quote for your own basket?</h2><p><a href="/price-calculator/">Use the price calculator</a> for distance, pickup and your selected time. <a href="/contact/">Contact the kitchen</a> for dietary questions or a group order.</p></aside>
    </div>
    <script>
      function revealAnswer() {
        let id: string;
        try { id=decodeURIComponent(location.hash.slice(1)); } catch { return; }
        const answer=document.getElementById(id);
        if(answer instanceof HTMLDetailsElement) answer.open=true;
      }
      revealAnswer();
      window.addEventListener('hashchange',revealAnswer);
    </script>
  </main>
</Layout>
