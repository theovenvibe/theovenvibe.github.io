---
// Contact — ported verbatim from v1's contact.html (PRD §8 superseded block).
// v1 has no sticky WhatsApp FAB on this page — preserved as-is (showWaFab=false).
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/data';

const title = `Contact Us - ${site.business.name} | Sundargarh Takeaway`;
const description = `Contact ${site.business.name}, Sundargarh. WhatsApp, Instagram and contact form available.`;
const ogImage = new URL(
  '/static/images/brand_images/The%20Oven%20vibe_logo.webp',
  Astro.site,
).toString();
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<Layout title={title} description={description} activeContact={true} showWaFab={false}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
  </Fragment>

  <main class="main">
    <!-- HERO SECTION -->
    <section class="hero hero-mini">
      <div class="hero-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
      </div>
      <div class="hero-container">
        <div class="hero-content">
          <h1 class="hero-display" style="font-size: clamp(2rem, 5vw, 4rem)">
            <span class="animate-on-scroll">LET'S</span>
            <span class="text-gradient animate-on-scroll delay-100">CONNECT.</span>
          </h1>
          <p class="hero-text animate-on-scroll delay-200">
            Questions? Party orders? Just want to say hi?
            <br />We are just a message away.
          </p>
        </div>
      </div>
    </section>

    <div class="section" style="padding-top: 0">
      <div class="container">
        <!-- Google Form embed -->
        <div class="container" style="max-width: 800px; margin: 0 auto">
          <iframe
            class="contact-form-iframe"
            src="https://docs.google.com/forms/d/e/1FAIpQLSe904p8LQBV3Dh5w-_sWOJzmFNT_DXoAVMoYfx_UguIuJflTA/viewform?embedded=true"
            loading="lazy">Loading…</iframe
          >
        </div>
      </div>
    </div>
  </main>
</Layout>
