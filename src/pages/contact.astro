---
// Contact — Phase 1 stub. Full page (map, QR, bulk orders) in Phase 3.
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/data';
---

<Layout
  title={`Contact — ${site.business.name} Sundargarh`}
  description={`Call or WhatsApp ${site.business.name}: ${site.business.phone_display}. ${site.business.hours.display}.`}
>
  <main class="mx-auto max-w-3xl px-4 py-16 text-center">
    <h1 class="text-3xl font-bold">Contact Us</h1>
    <p class="mt-4">{site.business.hours.display}</p>
    <p class="mt-2 text-neutral-400">{site.delivery.radius_note}</p>
    <div class="mt-8 flex justify-center gap-4">
      <a
        href={`tel:${site.business.phone}`}
        class="rounded-full bg-amber-500 px-6 py-3 font-semibold text-neutral-950"
        aria-label={`Call ${site.business.name} at ${site.business.phone_display}`}
        >Call {site.business.phone_display}</a
      >
      <a
        href={`https://wa.me/${site.business.whatsapp}`}
        class="rounded-full border border-neutral-600 px-6 py-3 font-semibold">WhatsApp</a
      >
    </div>
  </main>
</Layout>
