---
// Contact — v1's structure (PRD §8 superseded block) plus the Phase 4
// lead-capture block: v1's contact page carried a Google Form and nothing
// else — no phone number, no WhatsApp link, no hours — on the one page people
// land on when they want to reach us. The NAP block below is also what keeps
// the site's address/phone/hours identical to the Google Business Profile.
import Layout from '../layouts/Layout.astro';
import { site, deliverySlabLine, deliveryFreeAboveLine } from '../lib/data';
import { LINKS, breadcrumbJsonLd, restaurantJsonLd } from '../lib/seo';

const title = 'Contact & Order | The Oven Vibe Sundargarh';
const description = `Call or WhatsApp ${site.business.name}, Sundargarh ${site.business.address.postal_code}. Open ${site.business.hours.display}. Takeaway in 20 minutes, delivery from ₹${site.delivery.slabs[0].charge}.`;
---

<Layout
  title={title}
  description={description}
  activeContact={true}
  showWaFab={false}
  jsonLd={[
    restaurantJsonLd({ withMenu: false }),
    breadcrumbJsonLd([{ name: 'Contact', path: '/contact/' }]),
  ]}
>

  <main class="main">
    <!-- HERO SECTION -->
    <section class="hero hero-mini">
      <div class="hero-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
      </div>
      <div class="hero-container">
        <div class="hero-content">
          <h1 class="hero-display" style="font-size: clamp(2rem, 5vw, 4rem)">
            <span class="animate-on-scroll">LET'S</span>
            <span class="text-gradient animate-on-scroll delay-100">CONNECT.</span>
          </h1>
          <p class="hero-text animate-on-scroll delay-200">
            Orders, party quotes, feedback — the fastest answer is a phone call.
          </p>
          <div class="hero-actions animate-on-scroll delay-300">
            <a
              href={`tel:${site.business.phone}`}
              class="btn btn-primary btn-lg"
              >Call {site.business.phone_display}</a
            >
            <a
              href={LINKS.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary btn-lg">Order on WhatsApp</a
            >
          </div>
        </div>
      </div>
    </section>

    <div class="section" style="padding-top: 0">
      <div class="container">
        <h2 class="sr-only">Visit, hours and delivery</h2>
        <div class="grid-3" style="margin-bottom: 3rem;">
            <article class="feature-card animate-on-scroll">
              <h3>Where we are</h3>
              <p>
                {site.business.address.locality}, {site.business.address.region} {site.business.address.postal_code}<br />
                <a
                  href={LINKS.maps}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="read-more"
                  aria-label="Open The Oven Vibe on Google Maps">Open in Google Maps</a
                >
              </p>
            </article>
            <article class="feature-card animate-on-scroll delay-100">
              <h3>When we are open</h3>
              <p>
                {site.business.hours.display}<br />
                Takeaway ready in about 20 minutes. Delivery 30-45 minutes.
              </p>
            </article>
            <article class="feature-card animate-on-scroll delay-200">
              <h3>Delivery</h3>
              <p>
                {deliverySlabLine}<br />
                {deliveryFreeAboveLine}
              </p>
            </article>
        </div>

        <div class="container" style="max-width: 800px; margin: 0 auto">
          <p style="text-align: center; margin-bottom: 2.5rem;">
            <span class="veg-badge">100% Pure Veg</span>
          </p>

          <h2 style="text-align: center; margin-bottom: 0.75rem;">Send us a message</h2>
          <p class="lead" style="text-align: center; margin-bottom: 2rem;">
            Not urgent? Leave your details and we will get back to you.
          </p>

          <!-- Google Form embed -->
          <iframe
            class="contact-form-iframe"
            title="Contact form"
            src="https://docs.google.com/forms/d/e/1FAIpQLSe904p8LQBV3Dh5w-_sWOJzmFNT_DXoAVMoYfx_UguIuJflTA/viewform?embedded=true"
            loading="lazy">Loading…</iframe
          >
        </div>
      </div>
    </div>
  </main>
</Layout>
